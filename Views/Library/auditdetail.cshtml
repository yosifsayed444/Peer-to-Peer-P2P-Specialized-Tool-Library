    <main class="py-5">
        <div class="container">
            <div class="mb-4">
                <a href="/Library/inventoryaudits" class="btn btn-link px-0 text-decoration-none"><i class="fas fa-arrow-left me-1"></i> Back to Audits</a>
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mt-2">
                    <div><h1 class="h2 fw-bold mb-1">Audit #A-104</h1><p class="text-muted mb-0">Cordless Drill • Monika Adel • Nasr City</p></div>
                    <span class="badge text-bg-info fs-6">Photo submitted</span>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Audit Requirements</h2></div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between"><span>Take a photo of the tool</span><strong>Required</strong></li>
                                <li class="list-group-item d-flex justify-content-between"><span>Include a paper with today's date</span><strong>Required</strong></li>
                                <li class="list-group-item d-flex justify-content-between"><span>Show the serial number or label</span><strong>Recommended</strong></li>
                                <li class="list-group-item d-flex justify-content-between"><span>Deadline</span><strong>Oct 30, 2026</strong></li>
                            </ul>
                        </div>
                    </div>
                    <div class="card shadow-sm">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Submitted Evidence</h2></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6"><div class="border rounded p-3 text-center h-100"><i class="fas fa-image fa-3x text-muted mb-2"></i><div class="small fw-semibold">Tool Photo</div><div class="text-muted small">Uploaded Oct 28</div></div></div>
                                <div class="col-md-6"><div class="border rounded p-3 text-center h-100"><i class="fas fa-file-alt fa-3x text-muted mb-2"></i><div class="small fw-semibold">Date Paper</div><div class="text-muted small">Visible in photo</div></div></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Review</h2></div>
                        <div class="card-body">
                            <label class="form-label">Decision</label>
                            <select class="form-select mb-3"><option>Approve</option><option>Reject — retake photo</option><option>Escalate</option></select>
                            <label class="form-label">Notes</label>
                            <textarea class="form-control mb-3" rows="4" placeholder="Add review notes…"></textarea>
                            <button class="btn btn-success w-100 mb-2"><i class="fas fa-check"></i> Approve Audit</button>
                            <button class="btn btn-outline-danger w-100"><i class="fas fa-times"></i> Reject</button>
                        </div>
                    </div>
                    <div class="card shadow-sm">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Owner Info</h2></div>
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3"><div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:48px;height:48px;">MA</div><div><strong>Monika Adel</strong><div class="text-muted small">monika@@mail.com • Trust 92</div></div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

