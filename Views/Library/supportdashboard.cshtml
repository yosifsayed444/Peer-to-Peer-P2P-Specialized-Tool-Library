<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Support Dashboard - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link rel="stylesheet" href="/css/dashboard.css?v=2">
    <link rel="stylesheet" href="/css/components.css">
    <style>
        /* Function number badge next to sidebar items */
        .sidebar-item .fn-num {
            background: var(--light-color);
            border: 1px solid var(--border-color);
            color: var(--secondary-color);
            border-radius: 4px;
            font-size: 0.6rem;
            font-weight: 700;
            width: 1.5rem;
            text-align: center;
            flex-shrink: 0;
            font-family: monospace;
        }
        .sidebar-item .fn-name {
            font-size: 0.82rem;
        }
    </style>
</head>
<body>
    <!-- Navbar (authenticated template) -->
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/Home/Index" class="logo">
                <i class="fas fa-tools"></i>
                <span>ToolShare</span>
            </a>
            <button class="mobile-menu-btn" id="mobile-menu-btn">
                <i class="fas fa-bars"></i>
            </button>
            <div class="nav-menu" id="nav-menu">
                <a href="/Home/Index" class="nav-link"><i class="fas fa-home"></i> Home</a>
                <a href="/Home/tools" class="nav-link"><i class="fas fa-search"></i> Browse Tools</a>
                <div class="dropdown">
                    <button class="dropdown-btn">
                        <i class="fas fa-user-cog"></i> Librarian Panel <i class="fas fa-chevron-down"></i>
                    </button>
                    <div class="dropdown-content">
                        <a href="/Library/supportdashboard"><i class="fas fa-chart-line"></i> Dashboard</a>
                        <a href="/Library/disputes"><i class="fas fa-gavel"></i> Disputes</a>
                        <a href="/Home/profile"><i class="fas fa-user"></i> My Profile</a>
                        <div class="dropdown-divider"></div>
                        <a href="/Home/messages"><i class="fas fa-envelope"></i> Messages</a>
                        <a href="/Library/zones"><i class="fas fa-map-marker-alt"></i> Zones</a>
                    </div>
                </div>
                <button class="btn btn-outline"><i class="fas fa-sign-out-alt"></i> Logout</button>
            </div>
        </div>
    </nav>

    <div class="dashboard-container">
        <!-- Sidebar : وحدة المكتبة (15–28) من محضر المشروع -->
        <aside class="dashboard-sidebar">
            <div class="sidebar-nav" id="sidebar-nav"></div>
        </aside>

        <!-- Main area -->
        <main class="dashboard-main">
            <h1><i class="fas fa-headset"></i> Library Operations Dashboard</h1>

            <!-- Stats : طبقاً لمثال اللوحة (وظيفة 28) -->
            <div class="stats-grid">
                <div class="stat-card stat-card-success">
                    <div class="stat-icon"><i class="fas fa-calendar-check"></i></div>
                    <div class="stat-value">12</div>
                    <div class="stat-label">Active Rentals</div>
                </div>
                <div class="stat-card stat-card-danger">
                    <div class="stat-icon"><i class="fas fa-exclamation-circle"></i></div>
                    <div class="stat-value">3</div>
                    <div class="stat-label">Late Returns</div>
                </div>
                <div class="stat-card stat-card-warning">
                    <div class="stat-icon"><i class="fas fa-gavel"></i></div>
                    <div class="stat-value">5</div>
                    <div class="stat-label">Pending Disputes</div>
                </div>
                <div class="stat-card stat-card-primary">
                    <div class="stat-icon"><i class="fas fa-wallet"></i></div>
                    <div class="stat-value">8,500</div>
                    <div class="stat-label">In Escrow (EGP)</div>
                </div>
            </div>

            <!-- Disputes queue -->
            <div class="card">
                <div class="card-header"><i class="fas fa-gavel"></i> Dispute Mediation Hub</div>
                <div class="card-body table-container">
                    <table class="data-table">
                        <thead>
                            <tr><th>ID</th><th>Tool</th><th>Reported By</th><th>Against</th><th>Type</th><th>Status</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>#33</td>
                                <td>Angle Grinder</td>
                                <td>Omar Ali</td>
                                <td>Monika Adel</td>
                                <td>Damage</td>
                                <td><span class="badge badge-warning">open</span></td>
                                <td>
                                    <button class="btn-icon view"><i class="fas fa-eye"></i></button>
                                    <button class="btn-icon edit"><i class="fas fa-gavel"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td>#32</td>
                                <td>Cordless Drill</td>
                                <td>Ahmed Hassan</td>
                                <td>Tool Library</td>
                                <td>Payment</td>
                                <td><span class="badge badge-info">in review</span></td>
                                <td>
                                    <button class="btn-icon view"><i class="fas fa-eye"></i></button>
                                    <button class="btn-icon edit"><i class="fas fa-gavel"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td>#31</td>
                                <td>Garden Shears</td>
                                <td>Sara Mostafa</td>
                                <td>Mahmoud Samir</td>
                                <td>Late Return</td>
                                <td><span class="badge badge-success">resolved</span></td>
                                <td>
                                    <button class="btn-icon view"><i class="fas fa-eye"></i></button>
                                    <button class="btn-icon edit"><i class="fas fa-gavel"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Activity feed -->
            <div class="card">
                <div class="card-header"><i class="fas fa-bell"></i> Recent Activity</div>
                <div class="card-body activity-feed">
                    <div class="activity-item">
                        <div class="activity-icon"><i class="fas fa-exclamation-triangle"></i></div>
                        <div class="activity-content">
                            <div class="activity-text">New dispute opened on booking #1012</div>
                            <div class="activity-time">10 minutes ago</div>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon"><i class="fas fa-check-circle"></i></div>
                        <div class="activity-content">
                            <div class="activity-text">Dispute #31 marked as resolved</div>
                            <div class="activity-time">1 hour ago</div>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon"><i class="fas fa-envelope"></i></div>
                        <div class="activity-content">
                            <div class="activity-text">New message from Ahmed Hassan</div>
                            <div class="activity-time">2 hours ago</div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Mobile menu toggle (UI plumbing only) -->
    <script>
        document.getElementById('mobile-menu-btn').addEventListener('click', function () {
            document.getElementById('nav-menu').classList.toggle('active');
        });
    </script>
    <script src="/js/functions-data.js"></script>
    <script src="/js/sidebar.js"></script>
    <script>renderSidebar('support', 'support-dashboard.html');</script>
    <script src="/js/dashboard-ui.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
