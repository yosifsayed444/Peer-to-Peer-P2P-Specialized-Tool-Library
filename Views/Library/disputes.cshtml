    <main class="py-5">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h1 class="h2 fw-bold mb-1"><i class="fas fa-gavel text-primary me-2"></i>Dispute Mediation Hub</h1>
                    <p class="text-muted mb-0">Review evidence, communicate with both parties, and issue decisions.</p>
                </div>
                <a href="/Library/disputedetail" class="btn btn-primary"><i class="fas fa-plus"></i> New Dispute</a>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Open Disputes</div><div class="display-6 fw-bold text-warning">5</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">In Review</div><div class="display-6 fw-bold text-primary">2</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Resolved</div><div class="display-6 fw-bold text-success">34</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Re-opened</div><div class="display-6 fw-bold text-danger">3</div></div></div></div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4"><input type="text" class="form-control" placeholder="Search dispute, tool, user"></div>
                        <div class="col-md-3"><select class="form-select"><option>All types</option><option>Damage</option><option>Payment</option><option>Late Return</option><option>Other</option></select></div>
                        <div class="col-md-3"><select class="form-select"><option>All statuses</option><option>open</option><option>in review</option><option>resolved</option><option>rejected</option></select></div>
                        <div class="col-md-2"><button class="btn btn-outline-primary w-100"><i class="fas fa-filter"></i> Apply</button></div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead><tr><th>ID</th><th>Tool</th><th>Reported By</th><th>Against</th><th>Type</th><th>Opened</th><th>Status</th><th>Actions</th></tr></thead>
                            <tbody>
                                <tr><td>#33</td><td>Angle Grinder</td><td>Omar Ali</td><td>Monika Adel</td><td>Damage</td><td>Oct 26, 2026</td><td><span class="badge text-bg-warning text-dark">open</span></td><td><a href="/Library/disputedetail" class="btn btn-sm btn-outline-primary">Review</a></td></tr>
                                <tr><td>#32</td><td>Cordless Drill</td><td>Ahmed Hassan</td><td>Tool Library</td><td>Payment</td><td>Oct 24, 2026</td><td><span class="badge text-bg-info">in review</span></td><td><a href="/Library/disputedetail" class="btn btn-sm btn-outline-primary">Review</a></td></tr>
                                <tr><td>#31</td><td>Garden Shears</td><td>Sara Mostafa</td><td>Mahmoud Samir</td><td>Late Return</td><td>Oct 20, 2026</td><td><span class="badge text-bg-success">resolved</span></td><td><a href="/Library/disputedetail" class="btn btn-sm btn-outline-primary">View</a></td></tr>
                                <tr><td>#29</td><td>3D Printer</td><td>Hana Yousry</td><td>Sara Mostafa</td><td>Damage</td><td>Oct 12, 2026</td><td><span class="badge text-bg-success">resolved</span></td><td><a href="/Library/disputedetail" class="btn btn-sm btn-outline-primary">View</a></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-white"><h2 class="h5 mb-0">Linked Refund Decision</h2></div>
                <div class="card-body">
                    <p class="mb-3">Dispute #32 — <strong>Cordless Drill</strong>, payment type. Suggested partial refund:</p>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-success btn-sm"><i class="fas fa-check"></i> Approve partial refund 120 EGP</button>
                        <button class="btn btn-danger btn-sm"><i class="fas fa-times"></i> Reject refund</button>
                        <button class="btn btn-outline-secondary btn-sm"><i class="fas fa-comment"></i> Ask borrower for evidence</button>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5"><div class="container text-center text-muted"><p class="mb-1">© 2024 ToolShare. All rights reserved.</p><div class="d-flex justify-content-center gap-3"><a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a><a href="/Home/terms" class="text-decoration-none">Terms of Service</a><a href="/Home/support" class="text-decoration-none">Safety Guidelines</a></div></div></footer>

