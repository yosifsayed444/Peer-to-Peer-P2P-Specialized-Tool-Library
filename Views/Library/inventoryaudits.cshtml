    <main class="py-5">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h1 class="h2 fw-bold mb-1">Inventory Audits</h1>
                    <p class="text-muted mb-0">Random checks to verify that listed tools physically exist and are in good condition.</p>
                </div>
                <button class="btn btn-primary"><i class="fas fa-plus"></i> New Audit</button>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Pending</div><div class="display-6 fw-bold text-warning">7</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">In Review</div><div class="display-6 fw-bold text-primary">3</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Approved</div><div class="display-6 fw-bold text-success">18</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Failed</div><div class="display-6 fw-bold text-danger">2</div></div></div></div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4"><input type="text" class="form-control" placeholder="Search tool or owner"></div>
                        <div class="col-md-3"><select class="form-select"><option>All statuses</option><option>Pending</option><option>Photo submitted</option><option>Approved</option><option>Rejected</option></select></div>
                        <div class="col-md-3"><select class="form-select"><option>All zones</option><option>Nasr City</option><option>Maadi</option><option>Heliopolis</option></select></div>
                        <div class="col-md-2"><button class="btn btn-outline-primary w-100"><i class="fas fa-filter"></i> Apply</button></div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead><tr><th>Tool</th><th>Owner</th><th>Zone</th><th>Due Date</th><th>Status</th><th>Photo</th><th>Actions</th></tr></thead>
                            <tbody>
                                <tr><td>Cordless Drill</td><td>Monika Adel</td><td>Nasr City</td><td>Oct 30, 2026</td><td><span class="badge text-bg-warning text-dark">Pending</span></td><td><span class="text-muted">—</span></td><td><button class="btn btn-sm btn-outline-primary">Review</button></td></tr>
                                <tr><td>3D Printer</td><td>Sara Mostafa</td><td>Zamalek</td><td>Oct 28, 2026</td><td><span class="badge text-bg-info">Photo submitted</span></td><td><a href="/Library/auditdetail" class="btn btn-sm btn-outline-secondary">View</a></td><td><button class="btn btn-sm btn-success">Approve</button> <button class="btn btn-sm btn-outline-danger">Reject</button></td></tr>
                                <tr><td>Garden Shears</td><td>Ahmed Hassan</td><td>Maadi</td><td>Oct 25, 2026</td><td><span class="badge text-bg-success">Approved</span></td><td><a href="/Library/auditdetail" class="btn btn-sm btn-outline-secondary">View</a></td><td><button class="btn btn-sm btn-outline-primary">Details</button></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5">
        <div class="container text-center text-muted">
            <p class="mb-1">© 2024 ToolShare. All rights reserved.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a>
                <a href="/Home/terms" class="text-decoration-none">Terms of Service</a>
                <a href="/Home/support" class="text-decoration-none">Safety Guidelines</a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
