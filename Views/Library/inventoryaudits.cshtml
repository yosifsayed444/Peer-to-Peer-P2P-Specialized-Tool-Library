                            <li><a class="dropdown-item" href="/Library/handovermanagement"><i class="fas fa-qrcode"></i> Handovers</a></li>
                            <li><a class="dropdown-item" href="/Library/insuranceclaims"><i class="fas fa-file-invoice"></i> Claims</a></li>
                            <li><a class="dropdown-item" href="/Library/latereturns"><i class="fas fa-clock"></i> Late Returns</a></li>
                            <li><a class="dropdown-item" href="/Library/blacklist"><i class="fas fa-ban"></i> Blacklist</a></li>
                            <li><a class="dropdown-item" href="/Library/promotions"><i class="fas fa-bullhorn"></i> Campaigns</a></li>
                            <li><a class="dropdown-item" href="/Library/broadcasts"><i class="fas fa-rss"></i> Broadcasts</a></li>
