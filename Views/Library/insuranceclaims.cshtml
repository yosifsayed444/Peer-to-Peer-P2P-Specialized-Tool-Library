    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="fas fa-user-cog"></i> Librarian Panel</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/Library/supportdashboard"><i class="fas fa-chart-line"></i> Dashboard</a></li>
                            <li><a class="dropdown-item" href="/Library/librariantasks"><i class="fas fa-list-check"></i> My Tasks</a></li>
                            <li><a class="dropdown-item" href="/Library/disputes"><i class="fas fa-gavel"></i> Disputes</a></li>
                            <li><a class="dropdown-item" href="/Library/inventoryaudits"><i class="fas fa-clipboard-check"></i> Audits</a></li>
                            <li><a class="dropdown-item" href="/Library/handovermanagement"><i class="fas fa-qrcode"></i> Handovers</a></li>
                            <li><a class="dropdown-item" href="/Library/insuranceclaims"><i class="fas fa-file-invoice"></i> Claims</a></li>
                            <li><a class="dropdown-item" href="/Library/latereturns"><i class="fas fa-clock"></i> Late Returns</a></li>
                            <li><a class="dropdown-item" href="/Library/blacklist"><i class="fas fa-ban"></i> Blacklist</a></li>
                            <li><a class="dropdown-item" href="/Library/promotions"><i class="fas fa-bullhorn"></i> Campaigns</a></li>
                            <li><a class="dropdown-item" href="/Library/broadcasts"><i class="fas fa-rss"></i> Broadcasts</a></li>
                            <li><a class="dropdown-item" href="/Library/reports"><i class="fas fa-chart-bar"></i> Reports</a></li>
                            <li><a class="dropdown-item" href="/Library/zones"><i class="fas fa-map-marked-alt"></i> Zones</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/Home/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                            <li><a class="dropdown-item" href="/Home/profile"><i class="fas fa-user"></i> My Profile</a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><button class="btn btn-outline-secondary"><i class="fas fa-sign-out-alt"></i> Logout</button></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h1 class="h2 fw-bold mb-1">Insurance Claims</h1>
                    <p class="text-muted mb-0">Generate and track reports for stolen or damaged high-value tools.</p>
                </div>
                <button class="btn btn-primary"><i class="fas fa-file-export"></i> New Claim</button>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Open Claims</div><div class="display-6 fw-bold text-warning">4</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Under Review</div><div class="display-6 fw-bold text-primary">2</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Approved</div><div class="display-6 fw-bold text-success">11</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Total Value</div><div class="display-6 fw-bold">48,500 EGP</div></div></div></div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4"><input type="text" class="form-control" placeholder="Search claim or tool"></div>
                        <div class="col-md-3"><select class="form-select"><option>All statuses</option><option>Open</option><option>In review</option><option>Approved</option><option>Rejected</option></select></div>
                        <div class="col-md-3"><input type="date" class="form-control"></div>
                        <div class="col-md-2"><button class="btn btn-outline-primary w-100"><i class="fas fa-filter"></i> Apply</button></div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead><tr><th>Claim #</th><th>Tool</th><th>Booking</th><th>Value</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead>
                            <tbody>
                                <tr><td>#C-102</td><td>3D Printer</td><td>#1015</td><td>15,000 EGP</td><td><span class="badge text-bg-warning text-dark">Open</span></td><td>Oct 22, 2026</td><td><button class="btn btn-sm btn-outline-primary">View</button> <button class="btn btn-sm btn-outline-secondary">Report</button></td></tr>
                                <tr><td>#C-101</td><td>Cordless Drill</td><td>#1008</td><td>2,200 EGP</td><td><span class="badge text-bg-info">In review</span></td><td>Oct 18, 2026</td><td><button class="btn btn-sm btn-outline-primary">View</button> <button class="btn btn-sm btn-outline-secondary">Report</button></td></tr>
                                <tr><td>#C-099</td><td>Angle Grinder</td><td>#0992</td><td>1,800 EGP</td><td><span class="badge text-bg-success">Approved</span></td><td>Oct 10, 2026</td><td><button class="btn btn-sm btn-outline-primary">View</button></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5">
        <div class="container text-center text-muted">
            <p class="mb-1">© 2024 ToolShare. All rights reserved.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a>
                <a href="/Home/terms" class="text-decoration-none">Terms of Service</a>
                <a href="/Home/support" class="text-decoration-none">Safety Guidelines</a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
