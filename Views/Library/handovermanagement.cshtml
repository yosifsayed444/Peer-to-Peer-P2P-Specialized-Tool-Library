    <main class="py-5">
        <div class="container">
            <div class="mb-4">
                <h1 class="h2 fw-bold mb-1">Handover Management</h1>
                <p class="text-muted mb-0">Track QR-based pickups and returns across all bookings.</p>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Pending QR</div><div class="display-6 fw-bold text-warning">12</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Verified Today</div><div class="display-6 fw-bold text-success">34</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Failed Scans</div><div class="display-6 fw-bold text-danger">2</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Avg. Time</div><div class="display-6 fw-bold">4 min</div></div></div></div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4"><input type="text" class="form-control" placeholder="Search booking or user"></div>
                        <div class="col-md-3"><select class="form-select"><option>All statuses</option><option>Pending</option><option>Verified</option><option>Failed</option></select></div>
                        <div class="col-md-3"><input type="date" class="form-control"></div>
                        <div class="col-md-2"><button class="btn btn-outline-primary w-100"><i class="fas fa-filter"></i> Apply</button></div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead><tr><th>Booking</th><th>Tool</th><th>Borrower</th><th>Lender</th><th>Scheduled</th><th>Status</th><th>Actions</th></tr></thead>
                            <tbody>
                                <tr><td>#1012</td><td>Cordless Drill</td><td>Ahmed Hassan</td><td>Monika Adel</td><td>Oct 20, 5:30 PM</td><td><span class="badge text-bg-warning text-dark">Pending QR</span></td><td><button class="btn btn-sm btn-outline-primary">View QR</button></td></tr>
                                <tr><td>#1010</td><td>Angle Grinder</td><td>Omar Ali</td><td>Monika Adel</td><td>Oct 18, 4:00 PM</td><td><span class="badge text-bg-success">Verified</span></td><td><button class="btn btn-sm btn-outline-primary">Details</button></td></tr>
                                <tr><td>#1008</td><td>Claw Hammer</td><td>Ahmed Hassan</td><td>Nada Fathi</td><td>Oct 12, 6:00 PM</td><td><span class="badge text-bg-danger">Failed scan</span></td><td><button class="btn btn-sm btn-outline-primary">Review</button></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

