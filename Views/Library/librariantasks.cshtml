    <main class="py-5">
        <div class="container">
            <div class="mb-4">
                <h1 class="h2 fw-bold mb-1"><i class="fas fa-list-check text-primary me-2"></i>My Tasks</h1>
                <p class="text-muted mb-0">Daily checklist for librarians — handovers, audits, disputes, and escalations.</p>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3"><div class="card shadow-sm border-warning"><div class="card-body"><div class="text-muted small">Due Today</div><div class="display-6 fw-bold text-warning">7</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Overdue</div><div class="display-6 fw-bold text-danger">2</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Completed</div><div class="display-6 fw-bold text-success">18</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Completion Rate</div><div class="display-6 fw-bold">89%</div></div></div></div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Today's Checklist</h2>
                    <span class="badge text-bg-primary">Nasr City Chapter</span>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div class="form-check"><input class="form-check-input" type="checkbox" id="t1"><label class="form-check-label" for="t1">Verify QR handover — Booking #1012 (5:30 PM)</label></div>
                        <a href="/Library/handoverdetail" class="btn btn-sm btn-outline-primary">Open</a>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div class="form-check"><input class="form-check-input" type="checkbox" id="t2"><label class="form-check-label" for="t2">Review dispute #33 — Angle Grinder damage claim</label></div>
                        <a href="/Library/disputedetail" class="btn btn-sm btn-outline-primary">Open</a>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div class="form-check"><input class="form-check-input" type="checkbox" id="t3"><label class="form-check-label" for="t3">Approve inventory audit #A-104 — Cordless Drill</label></div>
                        <a href="/Library/auditdetail" class="btn btn-sm btn-outline-primary">Open</a>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div class="form-check"><input class="form-check-input" type="checkbox" id="t4"><label class="form-check-label" for="t4">Follow up late return — Booking #1010 (1 day overdue)</label></div>
                        <a href="/Library/latereturns" class="btn btn-sm btn-outline-primary">Open</a>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div class="form-check"><input class="form-check-input" type="checkbox" id="t5"><label class="form-check-label" for="t5">Process insurance claim #C-102 — 3D Printer</label></div>
                        <a href="/Library/claimdetail" class="btn btn-sm btn-outline-primary">Open</a>
                    </li>
                </ul>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-white"><h2 class="h5 mb-0">Upcoming Handovers (This Week)</h2></div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>Booking</th><th>Tool</th><th>Borrower</th><th>Scheduled</th><th>Desk</th><th>Status</th><th>Actions</th></tr></thead>
                        <tbody>
                            <tr><td>#1012</td><td>Cordless Drill</td><td>Ahmed Hassan</td><td>Today 5:30 PM</td><td>Desk A</td><td><span class="badge text-bg-warning text-dark">Pending</span></td><td><a href="/Library/handoverdetail" class="btn btn-sm btn-outline-primary">Verify</a></td></tr>
                            <tr><td>#1014</td><td>Garden Shears</td><td>Hana Yousry</td><td>Tomorrow 11:00 AM</td><td>Desk B</td><td><span class="badge text-bg-secondary">Scheduled</span></td><td><a href="/Library/handoverdetail" class="btn btn-sm btn-outline-primary">Prep</a></td></tr>
                            <tr><td>#1015</td><td>3D Printer</td><td>Sara Mostafa</td><td>Oct 30, 2:00 PM</td><td>Desk A</td><td><span class="badge text-bg-secondary">Scheduled</span></td><td><a href="/Library/handoverdetail" class="btn btn-sm btn-outline-primary">Prep</a></td></tr>
                        </tbody>
                    </table>
