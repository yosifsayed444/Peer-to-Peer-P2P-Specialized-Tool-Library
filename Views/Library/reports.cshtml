    <main class="py-5">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h1 class="h2 fw-bold mb-1"><i class="fas fa-chart-bar text-primary me-2"></i>Reports</h1>
                    <p class="text-muted mb-0">Financial and operational reporting for platform revenue, refunds, and activity.</p>
                </div>
                <div class="d-flex gap-2"><button class="btn btn-outline-primary"><i class="fas fa-file-csv"></i> Export CSV</button><button class="btn btn-primary"><i class="fas fa-file-pdf"></i> Export PDF</button></div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Revenue This Month</div><div class="display-6 fw-bold">42,300 EGP</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Platform Commission</div><div class="display-6 fw-bold text-primary">18%</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Late Fines</div><div class="display-6 fw-bold text-warning">6,150 EGP</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Refunds</div><div class="display-6 fw-bold text-danger">2,410 EGP</div></div></div></div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white"><h2 class="h5 mb-0">Revenue Trend</h2></div>
                <div class="card-body">
                    <div class="d-flex align-items-end gap-4" style="height:180px;">
                        <div class="flex-fill text-center"><div class="bg-primary rounded-top" style="height:45%;"></div><div class="small text-muted mt-2">Aug</div></div>
                        <div class="flex-fill text-center"><div class="bg-primary rounded-top" style="height:60%;"></div><div class="small text-muted mt-2">Sep</div></div>
                        <div class="flex-fill text-center"><div class="bg-primary rounded-top" style="height:100%;"></div><div class="small text-muted mt-2">Oct</div></div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-3">Revenue Breakdown</h2>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead><tr><th>Source</th><th>Count</th><th>Amount</th><th>Share</th></tr></thead>
                            <tbody>
                                <tr><td>Rental commissions</td><td>234 bookings</td><td>7,614 EGP</td><td><span class="badge text-bg-primary">18%</span></td></tr>
                                <tr><td>Membership subscriptions</td><td>28 members</td><td>16,800 EGP</td><td><span class="badge text-bg-info">39%</span></td></tr>
                                <tr><td>Late fines and deposits forfeits</td><td>37 events</td><td>6,150 EGP</td><td><span class="badge text-bg-warning text-dark">14%</span></td></tr>
                                <tr><td>Boost credits</td><td>64 boosts</td><td>9,600 EGP</td><td><span class="badge text-bg-success">23%</span></td></tr>
                                <tr><td>Refunds issued</td><td>21 refunds</td><td class="text-danger">−2,410 EGP</td><td><span class="badge text-bg-danger">−6%</span></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5"><div class="container text-center text-muted"><p class="mb-1">© 2024 ToolShare. All rights reserved.</p><div class="d-flex justify-content-center gap-3"><a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a><a href="/Home/terms" class="text-decoration-none">Terms of Service</a><a href="/Home/support" class="text-decoration-none">Safety Guidelines</a></div></div></footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
