<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New User - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="fas fa-crown"></i> Admin Panel</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/Admin/admindashboard"><i class="fas fa-chart-line"></i> Dashboard</a></li>
                            <li><a class="dropdown-item" href="/Library/librariantasks"><i class="fas fa-list-check"></i> Tasks</a></li>
                            <li><a class="dropdown-item" href="/Library/bookings"><i class="fas fa-calendar-alt"></i> Bookings</a></li>
                            <li><a class="dropdown-item" href="/Library/toolsadmin"><i class="fas fa-tools"></i> Tools</a></li>
                            <li><a class="dropdown-item" href="/Library/users"><i class="fas fa-users"></i> Users</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/Library/inventoryaudits"><i class="fas fa-clipboard-check"></i> Audits</a></li>
                            <li><a class="dropdown-item" href="/Library/insuranceclaims"><i class="fas fa-file-invoice"></i> Claims</a></li>
                            <li><a class="dropdown-item" href="/Library/reports"><i class="fas fa-chart-bar"></i> Reports</a></li>
                            <li><a class="dropdown-item" href="/Library/zones"><i class="fas fa-map-marked-alt"></i> Zones</a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><button class="btn btn-outline-secondary"><i class="fas fa-sign-out-alt"></i> Logout</button></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            <div class="mb-4">
                <a href="/Library/users" class="btn btn-link px-0 text-decoration-none"><i class="fas fa-arrow-left me-1"></i> Back to Users</a>
                <h1 class="h2 fw-bold mt-2 mb-1"><i class="fas fa-user-plus text-primary me-2"></i>Add New User</h1>
                <p class="text-muted mb-0">Create a member account and review identity verification requirements.</p>
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Personal Information</h2></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6"><label class="form-label">Full Name *</label><input type="text" class="form-control"></div>
                                <div class="col-md-6"><label class="form-label">Email *</label><input type="email" class="form-control"></div>
                                <div class="col-md-6"><label class="form-label">Phone *</label><input type="tel" class="form-control"></div>
                                <div class="col-md-6"><label class="form-label">Password *</label><input type="password" class="form-control"></div>
                                <div class="col-md-6"><label class="form-label">Role</label><select class="form-select"><option>member</option><option>librarian</option><option>technician</option><option>admin</option></select></div>
                                <div class="col-md-6"><label class="form-label">Zone</label><select class="form-select"><option>Nasr City</option><option>Maadi</option><option>Heliopolis</option><option>Dokki</option><option>Zamalek</option></select></div>
                            </div>
                        </div>
                    </div>
                    <div class="card shadow-sm">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">KYC Verification</h2></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6"><label class="form-label">National ID</label><input type="text" class="form-control"></div>
                                <div class="col-md-6"><label class="form-label">ID Photo</label><input type="file" class="form-control" accept="image/*"></div>
                                <div class="col-12"><label class="form-label">Selfie with ID</label><input type="file" class="form-control" accept="image/*"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Account Settings</h2></div>
                        <div class="card-body">
                            <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="verified" checked><label class="form-check-label" for="verified">Mark as verified</label></div>
                            <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="pro"><label class="form-check-label" for="pro">Enable Pro tier</label></div>
                            <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="notify"><label class="form-check-label" for="notify">Email notifications</label></div>
                            <button class="btn btn-primary w-100"><i class="fas fa-save"></i> Create User</button>
                            <a href="/Library/users" class="btn btn-outline-secondary w-100 mt-2">Cancel</a>
                        </div>
                    </div>
                    <div class="alert alert-info"><i class="fas fa-info-circle"></i> High-value tools may require completed KYC before booking.</div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5"><div class="container text-center text-muted"><p class="mb-1">© 2024 ToolShare. All rights reserved.</p><div class="d-flex justify-content-center gap-3"><a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a><a href="/Home/terms" class="text-decoration-none">Terms of Service</a><a href="/Home/support" class="text-decoration-none">Safety Guidelines</a></div></div></footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
