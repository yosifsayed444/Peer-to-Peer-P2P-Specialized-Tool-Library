    <main class="py-5">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h1 class="h2 fw-bold mb-1">Promotional Campaigns</h1>
                    <p class="text-muted mb-0">Create discount codes and limited-time campaigns.</p>
                </div>
                <button class="btn btn-primary"><i class="fas fa-plus"></i> New Campaign</button>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Active Campaigns</div><div class="display-6 fw-bold text-success">3</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Scheduled</div><div class="display-6 fw-bold text-primary">2</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Expired</div><div class="display-6 fw-bold text-secondary">8</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Total Uses</div><div class="display-6 fw-bold">1,240</div></div></div></div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4"><input type="text" class="form-control" placeholder="Search campaign or code"></div>
                        <div class="col-md-3"><select class="form-select"><option>All statuses</option><option>Active</option><option>Scheduled</option><option>Expired</option></select></div>
                        <div class="col-md-3"><select class="form-select"><option>All categories</option><option>Garden</option><option>Power Tools</option><option>3D Printing</option></select></div>
                        <div class="col-md-2"><button class="btn btn-outline-primary w-100"><i class="fas fa-filter"></i> Apply</button></div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead><tr><th>Code</th><th>Discount</th><th>Category</th><th>Start</th><th>End</th><th>Uses</th><th>Status</th><th>Actions</th></tr></thead>
                            <tbody>
                                <tr><td>GARDEN30</td><td>30%</td><td>Garden</td><td>Apr 7, 2026</td><td>Apr 14, 2026</td><td>420</td><td><span class="badge text-bg-success">Active</span></td><td><button class="btn btn-sm btn-outline-primary">Edit</button></td></tr>
                                <tr><td>POWER15</td><td>15%</td><td>Power Tools</td><td>Oct 1, 2026</td><td>Oct 31, 2026</td><td>310</td><td><span class="badge text-bg-success">Active</span></td><td><button class="btn btn-sm btn-outline-primary">Edit</button></td></tr>
                                <tr><td>WELCOME10</td><td>10%</td><td>All</td><td>Jan 1, 2026</td><td>Dec 31, 2026</td><td>510</td><td><span class="badge text-bg-success">Active</span></td><td><button class="btn btn-sm btn-outline-primary">Edit</button></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

