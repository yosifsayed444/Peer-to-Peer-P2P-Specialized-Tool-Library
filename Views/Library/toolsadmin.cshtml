    <main class="py-5">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h1 class="h2 fw-bold mb-1"><i class="fas fa-tools text-primary me-2"></i>Tools Management</h1>
                    <p class="text-muted mb-0">Review all tool listings, statuses, pricing, and maintenance flags.</p>
                </div>
                <a href="/Member/addtool" class="btn btn-primary"><i class="fas fa-plus-circle"></i> Add New Tool</a>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Available</div><div class="display-6 fw-bold text-success">61</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Currently Rented</div><div class="display-6 fw-bold text-primary">22</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Locked / Unfit</div><div class="display-6 fw-bold text-danger">4</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Warranty Expiring</div><div class="display-6 fw-bold text-warning">9</div></div></div></div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4"><input type="text" class="form-control" placeholder="Search tool"></div>
                        <div class="col-md-3"><select class="form-select"><option>All categories</option><option>Power Tools</option><option>Hand Tools</option><option>Garden</option><option>3D Printing</option></select></div>
                        <div class="col-md-3"><select class="form-select"><option>All zones</option><option>Nasr City</option><option>Maadi</option><option>Heliopolis</option><option>Dokki</option><option>Zamalek</option></select></div>
                        <div class="col-md-2"><button class="btn btn-outline-primary w-100"><i class="fas fa-filter"></i> Apply</button></div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead><tr><th>ID</th><th>Tool</th><th>Owner</th><th>Category</th><th>Zone</th><th>Price/Day</th><th>Rating Sort</th><th>Status</th><th>Actions</th></tr></thead>
                            <tbody>
                                <tr><td>#22</td><td>Cordless Drill</td><td>Monika Adel</td><td>Power Tools</td><td>Nasr City</td><td>75 EGP</td><td><span class="text-warning">★★★★★</span></td><td><span class="badge text-bg-success">available</span></td><td><a href="/Home/tooldetail" class="btn btn-sm btn-outline-primary">View</a> <a href="/Maintenance/toolhealth" class="btn btn-sm btn-outline-warning">Health</a> <button class="btn btn-sm btn-outline-secondary">Edit</button></td></tr>
                                <tr><td>#18</td><td>Angle Grinder</td><td>Monika Adel</td><td>Power Tools</td><td>Nasr City</td><td>60 EGP</td><td><span class="text-warning">★★★★☆</span></td><td><span class="badge text-bg-info">rented</span></td><td><a href="/Home/tooldetail" class="btn btn-sm btn-outline-primary">View</a> <a href="/Maintenance/toolhealth" class="btn btn-sm btn-outline-warning">Health</a></td></tr>
                                <tr><td>#15</td><td>3D Printer</td><td>Sara Mostafa</td><td>3D Printing</td><td>Zamalek</td><td>150 EGP</td><td><span class="text-warning">★★★★★</span></td><td><span class="badge text-bg-warning text-dark">pending approval</span></td><td><a href="/Home/tooldetail" class="btn btn-sm btn-outline-primary">View</a> <button class="btn btn-sm btn-outline-success">Approve</button></td></tr>
                                <tr><td>#11</td><td>Garden Shears</td><td>Ahmed Hassan</td><td>Garden</td><td>Maadi</td><td>25 EGP</td><td><span class="text-warning">★★★★☆</span></td><td><span class="badge text-bg-danger">maintenance</span></td><td><a href="/Maintenance/toolhealth" class="btn btn-sm btn-outline-warning">Health</a> <button class="btn btn-sm btn-outline-danger">Lock</button></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

