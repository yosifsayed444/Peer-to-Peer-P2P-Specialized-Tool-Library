<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment History - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/memberdashboard"><i class="fas fa-gauge-high"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/mytools"><i class="fas fa-toolbox"></i> My Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/mybookings"><i class="fas fa-calendar-check"></i> Bookings</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/Member/wallet"><i class="fas fa-wallet"></i> Wallet</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/notifications"><i class="fas fa-bell"></i> Alerts</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/profile"><i class="fas fa-user"></i> Profile</a></li>
                    <li class="nav-item"><button class="btn btn-outline-secondary"><i class="fas fa-sign-out-alt"></i> Logout</button></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            <div class="mb-4">
                <a href="/Member/wallet" class="btn btn-link px-0 text-decoration-none"><i class="fas fa-arrow-left me-1"></i> Back to Wallet</a>
                <h1 class="h2 fw-bold mt-2 mb-1"><i class="fas fa-receipt text-primary me-2"></i>Payment History</h1>
                <p class="text-muted mb-0">All transactions: rentals, deposits, refunds, fines, and credits.</p>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Total Spent</div><div class="display-6 fw-bold">4,820 EGP</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Total Earned</div><div class="display-6 fw-bold text-success">1,240 EGP</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Deposits Held</div><div class="display-6 fw-bold text-warning">700 EGP</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Credits</div><div class="display-6 fw-bold text-info">150 EGP</div></div></div></div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4"><input type="text" class="form-control" placeholder="Search transaction"></div>
                        <div class="col-md-3"><select class="form-select"><option>All types</option><option>Rental payment</option><option>Deposit hold</option><option>Deposit release</option><option>Refund</option><option>Fine</option><option>Credit</option></select></div>
                        <div class="col-md-3"><input type="month" class="form-control"></div>
                        <div class="col-md-2"><button class="btn btn-outline-primary w-100"><i class="fas fa-filter"></i></button></div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead><tr><th>Date</th><th>Description</th><th>Booking</th><th>Type</th><th>Amount</th><th>Status</th></tr></thead>
                            <tbody>
                                <tr><td>Oct 22</td><td>Cordless Drill — 4 days</td><td>#1012</td><td><span class="badge text-bg-primary">Rental</span></td><td class="text-danger">−300 EGP</td><td><span class="badge text-bg-success">Paid</span></td></tr>
                                <tr><td>Oct 20</td><td>Deposit hold — Cordless Drill</td><td>#1012</td><td><span class="badge text-bg-warning text-dark">Deposit</span></td><td class="text-danger">−500 EGP</td><td><span class="badge text-bg-info">Held</span></td></tr>
                                <tr><td>Oct 15</td><td>Screwdriver Set — 3 days</td><td>#1011</td><td><span class="badge text-bg-primary">Rental</span></td><td class="text-danger">−60 EGP</td><td><span class="badge text-bg-success">Paid</span></td></tr>
                                <tr><td>Oct 10</td><td>Garden Shears — 4 days</td><td>#1009</td><td><span class="badge text-bg-primary">Rental</span></td><td class="text-danger">−100 EGP</td><td><span class="badge text-bg-success">Paid</span></td></tr>
                                <tr><td>Oct 05</td><td>Deposit release — Claw Hammer</td><td>#1008</td><td><span class="badge text-bg-success">Refund</span></td><td class="text-success">+50 EGP</td><td><span class="badge text-bg-success">Released</span></td></tr>
                                <tr><td>Oct 01</td><td>Referral credit — Sara Mostafa</td><td>—</td><td><span class="badge text-bg-info">Credit</span></td><td class="text-success">+100 EGP</td><td><span class="badge text-bg-success">Applied</span></td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5"><div class="container text-center text-muted"><p class="mb-1">© 2024 ToolShare. All rights reserved.</p><div class="d-flex justify-content-center gap-3"><a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a><a href="/Home/terms" class="text-decoration-none">Terms of Service</a><a href="/Home/support" class="text-decoration-none">Safety Guidelines</a></div></div></footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
