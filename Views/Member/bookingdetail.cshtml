<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Detail - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/memberdashboard"><i class="fas fa-gauge-high"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/mytools"><i class="fas fa-toolbox"></i> My Tools</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/Member/mybookings"><i class="fas fa-calendar-check"></i> Bookings</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/wallet"><i class="fas fa-wallet"></i> Wallet</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/notifications"><i class="fas fa-bell"></i> Alerts</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/profile"><i class="fas fa-user"></i> Profile</a></li>
                    <li class="nav-item"><button class="btn btn-outline-secondary"><i class="fas fa-sign-out-alt"></i> Logout</button></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            <div class="mb-4">
                <a href="/Member/mybookings" class="btn btn-link px-0 text-decoration-none"><i class="fas fa-arrow-left me-1"></i> Back to Bookings</a>
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mt-2">
                    <div>
                        <h1 class="h2 fw-bold mb-1">Booking #1012</h1>
                        <p class="text-muted mb-0">Cordless Drill • Monika Adel • Nasr City</p>
                    </div>
                    <span class="badge text-bg-success fs-6">Confirmed</span>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Booking Timeline</h2></div>
                        <div class="card-body">
                            <div class="d-flex gap-3 mb-3">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:36px;height:36px;flex:0 0 36px;"><i class="fas fa-check"></i></div>
                                <div><strong>Requested</strong><div class="text-muted small">Oct 18, 2026 • 9:12 AM</div></div>
                            </div>
                            <div class="d-flex gap-3 mb-3">
                                <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center" style="width:36px;height:36px;flex:0 0 36px;"><i class="fas fa-check"></i></div>
                                <div><strong>Approved & Payment Held</strong><div class="text-muted small">Oct 19, 2026 • 2:40 PM</div></div>
                            </div>
                            <div class="d-flex gap-3 mb-3">
                                <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center" style="width:36px;height:36px;flex:0 0 36px;"><i class="fas fa-clock"></i></div>
                                <div><strong>Waiting for Handover</strong><div class="text-muted small">Scheduled Oct 20, 2026 • 5:30 PM</div></div>
                            </div>
                            <div class="d-flex gap-3">
                                <div class="rounded-circle bg-light text-muted border d-flex align-items-center justify-content-center" style="width:36px;height:36px;flex:0 0 36px;"><i class="fas fa-qrcode"></i></div>
                                <div><strong>QR Handover Pending</strong><div class="text-muted small">Scan QR at pickup to confirm delivery</div></div>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Participants</h2></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="border rounded p-3 h-100">
                                        <div class="fw-semibold mb-1">Borrower</div>
                                        <div>Ahmed Hassan</div>
                                        <div class="text-muted small">ahmed.h@@mail.com</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="border rounded p-3 h-100">
                                        <div class="fw-semibold mb-1">Lender</div>
                                        <div>Monika Adel</div>
                                        <div class="text-muted small">monika@@mail.com</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Evidence & Photos</h2></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="border rounded p-3 text-center h-100">
                                        <i class="fas fa-image fa-2x text-muted mb-2"></i>
                                        <div class="small fw-semibold">Pickup Photo</div>
                                        <div class="text-muted small">Pending</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="border rounded p-3 text-center h-100">
                                        <i class="fas fa-image fa-2x text-muted mb-2"></i>
                                        <div class="small fw-semibold">Return Photo</div>
                                        <div class="text-muted small">Pending</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="border rounded p-3 text-center h-100">
                                        <i class="fas fa-qrcode fa-2x text-primary mb-2"></i>
                                        <div class="small fw-semibold">Handover QR</div>
                                        <div class="text-muted small">Ready</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Payment Summary</h2></div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2"><span>Rental</span><strong>300 EGP</strong></div>
                            <div class="d-flex justify-content-between mb-2"><span>Insurance</span><strong>15 EGP</strong></div>
                            <div class="d-flex justify-content-between mb-2"><span>Platform fee</span><strong>25 EGP</strong></div>
                            <div class="d-flex justify-content-between mb-2"><span>Deposit</span><strong>500 EGP</strong></div>
                            <hr>
                            <div class="d-flex justify-content-between fs-5 fw-bold"><span>Total</span><span>340 EGP</span></div>
                            <div class="text-muted small mt-1">Deposit is refundable after verified return.</div>
                        </div>
                    </div>

                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Quick Actions</h2></div>
                        <div class="card-body d-grid gap-2">
                            <a href="/Member/handover" class="btn btn-primary"><i class="fas fa-qrcode"></i> Open Handover</a>
                            <a href="/Home/messages" class="btn btn-outline-primary"><i class="fas fa-comment-dots"></i> Message Owner</a>
                            <a href="/Member/damagereport" class="btn btn-outline-danger"><i class="fas fa-file-medical"></i> Report Damage</a>
                            <button class="btn btn-outline-secondary"><i class="fas fa-times"></i> Cancel Booking</button>
                        </div>
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Return Verification</h2></div>
                        <div class="card-body">
                            <p class="text-muted small mb-2">After return, both parties confirm the tool condition.</p>
                            <div class="d-grid gap-2">
                                <button class="btn btn-success"><i class="fas fa-check"></i> Tool Returned Safely</button>
                                <button class="btn btn-outline-danger"><i class="fas fa-exclamation-triangle"></i> Report an Issue</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5">
        <div class="container text-center text-muted">
            <p class="mb-1">© 2024 ToolShare. All rights reserved.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a>
                <a href="/Home/terms" class="text-decoration-none">Terms of Service</a>
                <a href="/Home/support" class="text-decoration-none">Safety Guidelines</a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
