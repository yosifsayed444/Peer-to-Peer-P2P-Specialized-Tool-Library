<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notifications - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/memberdashboard"><i class="fas fa-gauge-high"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/mytools"><i class="fas fa-toolbox"></i> My Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/mybookings"><i class="fas fa-calendar-check"></i> Bookings</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/wallet"><i class="fas fa-wallet"></i> Wallet</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/Member/notifications"><i class="fas fa-bell"></i> Alerts</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/profile"><i class="fas fa-user"></i> Profile</a></li>
                    <li class="nav-item"><button class="btn btn-outline-secondary"><i class="fas fa-sign-out-alt"></i> Logout</button></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h1 class="h2 fw-bold mb-1">Notifications</h1>
                    <p class="text-muted mb-0">Stay updated on bookings, payments, maintenance, and platform alerts.</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary"><i class="fas fa-check-double"></i> Mark all read</button>
                    <button class="btn btn-outline-secondary"><i class="fas fa-trash"></i> Clear</button>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex flex-column flex-md-row gap-3 mb-3">
                        <div class="flex-grow-1"><input type="text" class="form-control" placeholder="Search notifications"></div>
                        <select class="form-select" style="max-width:220px;"><option>All types</option><option>Booking</option><option>Payment</option><option>Maintenance</option><option>Dispute</option></select>
                        <button class="btn btn-outline-primary"><i class="fas fa-filter"></i> Apply</button>
                    </div>

                    <div class="list-group list-group-flush">
                        <div class="list-group-item d-flex gap-3">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:42px;height:42px;flex:0 0 42px;"><i class="fas fa-calendar-check"></i></div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between gap-2">
                                    <strong>Booking reminder</strong>
                                    <span class="text-muted small">Today, 10:20 AM</span>
                                </div>
                                <div class="text-muted">Cordless Drill handover tomorrow at 5:30 PM. Please bring your ID.</div>
                                <a href="/Member/bookingdetail" class="btn btn-sm btn-link px-0">Open booking</a>
                            </div>
                            <span class="badge text-bg-primary align-self-start">Unread</span>
                        </div>
                        <div class="list-group-item d-flex gap-3">
                            <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center" style="width:42px;height:42px;flex:0 0 42px;"><i class="fas fa-wrench"></i></div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between gap-2">
                                    <strong>Maintenance alert</strong>
                                    <span class="text-muted small">Yesterday</span>
                                </div>
                                <div class="text-muted">Garden Shears battery health dropped to 71%. Consider replacing the battery soon.</div>
                                <a href="/Maintenance/toolhealth" class="btn btn-sm btn-link px-0">View tool health</a>
                            </div>
                        </div>
                        <div class="list-group-item d-flex gap-3">
                            <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center" style="width:42px;height:42px;flex:0 0 42px;"><i class="fas fa-wallet"></i></div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between gap-2">
                                    <strong>Payment update</strong>
                                    <span class="text-muted small">2 days ago</span>
                                </div>
                                <div class="text-muted">Deposit released for booking #1008. 50 EGP was returned to your wallet.</div>
                                <a href="/Member/wallet" class="btn btn-sm btn-link px-0">Open wallet</a>
                            </div>
                        </div>
                        <div class="list-group-item d-flex gap-3">
                            <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center" style="width:42px;height:42px;flex:0 0 42px;"><i class="fas fa-exclamation-triangle"></i></div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between gap-2">
                                    <strong>Late return warning</strong>
                                    <span class="text-muted small">3 days ago</span>
                                </div>
                                <div class="text-muted">Booking #1010 is 1 day late. A fine may apply if not returned today.</div>
                                <a href="/Member/bookingdetail" class="btn btn-sm btn-link px-0">Resolve now</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5">
        <div class="container text-center text-muted">
            <p class="mb-1">© 2024 ToolShare. All rights reserved.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a>
                <a href="/Home/terms" class="text-decoration-none">Terms of Service</a>
                <a href="/Home/support" class="text-decoration-none">Safety Guidelines</a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
