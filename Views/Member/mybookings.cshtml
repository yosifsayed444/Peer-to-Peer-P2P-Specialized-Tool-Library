<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Bookings - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/memberdashboard"><i class="fas fa-gauge-high"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/mytools"><i class="fas fa-toolbox"></i> My Tools</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/Member/mybookings"><i class="fas fa-calendar-check"></i> Bookings</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/wallet"><i class="fas fa-wallet"></i> Wallet</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/notifications"><i class="fas fa-bell"></i> Alerts</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/profile"><i class="fas fa-user"></i> Profile</a></li>
                    <li class="nav-item"><button class="btn btn-outline-secondary"><i class="fas fa-sign-out-alt"></i> Logout</button></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h1 class="h2 fw-bold mb-1">My Bookings</h1>
                    <p class="text-muted mb-0">Track rental requests, handovers, returns, deposits, and disputes.</p>
                </div>
                <a href="/Home/tools" class="btn btn-primary"><i class="fas fa-search"></i> Find a Tool</a>
            </div>

            <ul class="nav nav-tabs mb-4" id="bookingTabs" role="tablist">
                <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#upcoming" type="button">Upcoming</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#active" type="button">Active</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#completed" type="button">Completed</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#cancelled" type="button">Cancelled</button></li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="upcoming">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="row g-3 mb-3">
                                <div class="col-md-4"><input type="text" class="form-control" placeholder="Search booking"></div>
                                <div class="col-md-3"><select class="form-select"><option>All statuses</option><option>Pending</option><option>Confirmed</option><option>Waiting Handover</option></select></div>
                                <div class="col-md-3"><input type="date" class="form-control"></div>
                                <div class="col-md-2"><button class="btn btn-outline-primary w-100"><i class="fas fa-filter"></i> Filter</button></div>
                            </div>
                            <div class="list-group list-group-flush">
                                <div class="list-group-item d-flex flex-column flex-lg-row justify-content-between gap-3">
                                    <div>
                                        <div class="fw-semibold">Cordless Drill</div>
                                        <div class="text-muted small">#1012 • Monika Adel • Oct 20 → Oct 24</div>
                                        <div class="small text-muted mt-1">Pickup: Nasr City • Return: same location</div>
                                    </div>
                                    <div class="text-lg-end">
                                        <span class="badge text-bg-success">Confirmed</span>
                                        <div class="small mt-1">300 EGP + 500 EGP deposit</div>
                                        <div class="d-flex gap-2 justify-content-lg-end mt-2">
                                            <a href="/Member/bookingdetail" class="btn btn-sm btn-outline-primary">Details</a>
                                            <a href="/Member/handover" class="btn btn-sm btn-primary">QR Handover</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="list-group-item d-flex flex-column flex-lg-row justify-content-between gap-3">
                                    <div>
                                        <div class="fw-semibold">3D Printer</div>
                                        <div class="text-muted small">#1015 • Sara Mostafa • Oct 21 → Oct 25</div>
                                        <div class="small text-muted mt-1">Pickup: Zamalek • Return: same location</div>
                                    </div>
                                    <div class="text-lg-end">
                                        <span class="badge text-bg-warning text-dark">Pending Approval</span>
                                        <div class="small mt-1">600 EGP + 3,000 EGP deposit</div>
                                        <div class="d-flex gap-2 justify-content-lg-end mt-2">
                                            <a href="/Member/bookingdetail" class="btn btn-sm btn-outline-primary">Details</a>
                                            <button class="btn btn-sm btn-outline-danger">Cancel</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="active">
                    <div class="alert alert-info">No active rentals right now.</div>
                </div>
                <div class="tab-pane fade" id="completed">
                    <div class="alert alert-secondary">Completed bookings will appear here with return verification and deposit release status.</div>
                </div>
                <div class="tab-pane fade" id="cancelled">
                    <div class="alert alert-warning">Cancelled bookings will appear here with refund or credit notes.</div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5">
        <div class="container text-center text-muted">
            <p class="mb-1">© 2024 ToolShare. All rights reserved.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a>
                <a href="/Home/terms" class="text-decoration-none">Terms of Service</a>
                <a href="/Home/support" class="text-decoration-none">Safety Guidelines</a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
