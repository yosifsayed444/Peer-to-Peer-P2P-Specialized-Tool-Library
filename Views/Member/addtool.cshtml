<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New Tool - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/memberdashboard"><i class="fas fa-gauge-high"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/mytools"><i class="fas fa-toolbox"></i> My Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/mybookings"><i class="fas fa-calendar-check"></i> Bookings</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/wallet"><i class="fas fa-wallet"></i> Wallet</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/notifications"><i class="fas fa-bell"></i> Alerts</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/profile"><i class="fas fa-user"></i> Profile</a></li>
                    <li class="nav-item"><button class="btn btn-outline-secondary"><i class="fas fa-sign-out-alt"></i> Logout</button></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            <div class="mb-4">
                <a href="/Member/mytools" class="btn btn-link px-0 text-decoration-none"><i class="fas fa-arrow-left me-1"></i> Back to My Tools</a>
                <h1 class="h2 fw-bold mt-2 mb-1"><i class="fas fa-plus-circle text-primary me-2"></i>Add New Tool</h1>
                <p class="text-muted mb-0">Complete the listing so borrowers can understand specs, safety, pricing, and availability.</p>
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Basic Information</h2></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-8"><label class="form-label">Tool Name *</label><input type="text" class="form-control" placeholder="Example: Cordless Drill"></div>
                                <div class="col-md-4"><label class="form-label">Category *</label><select class="form-select"><option>Power Tools</option><option>Hand Tools</option><option>Garden</option><option>3D Printing</option><option>Woodworking</option></select></div>
                                <div class="col-12"><label class="form-label">Description</label><textarea class="form-control" rows="4" placeholder="What the tool does, projects it suits, included accessories…"></textarea></div>
                                <div class="col-md-4"><label class="form-label">Brand</label><input type="text" class="form-control"></div>
                                <div class="col-md-4"><label class="form-label">Condition</label><select class="form-select"><option>Excellent</option><option>Good</option><option>Fair</option></select></div>
                                <div class="col-md-4"><label class="form-label">Zone *</label><select class="form-select"><option>Nasr City</option><option>Maadi</option><option>Heliopolis</option><option>Dokki</option><option>Zamalek</option></select></div>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Pricing & Deposit</h2></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4"><label class="form-label">Price / Hour</label><input type="number" class="form-control" placeholder="10"></div>
                                <div class="col-md-4"><label class="form-label">Price / Day *</label><input type="number" class="form-control" placeholder="75"></div>
                                <div class="col-md-4"><label class="form-label">Price / Week</label><input type="number" class="form-control" placeholder="400"></div>
                                <div class="col-md-4"><label class="form-label">Deposit *</label><input type="number" class="form-control" placeholder="500"></div>
                                <div class="col-md-4"><label class="form-label">Insurance %</label><input type="number" class="form-control" placeholder="5"></div>
                                <div class="col-md-4"><label class="form-label">Max Borrow Days</label><input type="number" class="form-control" placeholder="7"></div>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Documents & Media</h2></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6"><label class="form-label">Photos</label><input type="file" class="form-control" multiple accept="image/*"></div>
                                <div class="col-md-6"><label class="form-label">User Manual (PDF)</label><input type="file" class="form-control" accept=".pdf"></div>
                                <div class="col-md-6"><label class="form-label">Safety Video</label><input type="file" class="form-control" accept="video/*"></div>
                                <div class="col-md-6"><label class="form-label">Safety Certificate</label><input type="file" class="form-control" accept="image/*,.pdf"></div>
                                <div class="col-md-6"><label class="form-label">Warranty Expiry</label><input type="date" class="form-control"></div>
                                <div class="col-md-6"><label class="form-label">Battery Health %</label><input type="number" class="form-control" placeholder="100"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Availability</h2></div>
                        <div class="card-body">
                            <label class="form-label">Cleaning buffer after each rental</label>
                            <select class="form-select mb-3"><option>2 hours</option><option>4 hours</option><option>10 hours</option><option>24 hours</option></select>
                            <label class="form-label">Weekly maintenance threshold</label>
                            <input type="number" class="form-control" placeholder="50">
                            <div class="form-text">Used for maintenance alerts and inspection scheduling.</div>
                        </div>
                    </div>
                    <div class="card shadow-sm">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Safety Checklist</h2></div>
                        <div class="card-body">
                            <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="s1"><label class="form-check-label" for="s1">Tool is safe to use</label></div>
                            <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="s2"><label class="form-check-label" for="s2">Includes all accessories</label></div>
                            <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="s3"><label class="form-check-label" for="s3">Manual uploaded</label></div>
                            <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="s4"><label class="form-check-label" for="s4">Safety video uploaded</label></div>
                            <button class="btn btn-primary w-100"><i class="fas fa-save"></i> Save Tool</button>
                            <a href="/Member/mytools" class="btn btn-outline-secondary w-100 mt-2">Cancel</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5"><div class="container text-center text-muted"><p class="mb-1">© 2024 ToolShare. All rights reserved.</p><div class="d-flex justify-content-center gap-3"><a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a><a href="/Home/terms" class="text-decoration-none">Terms of Service</a><a href="/Home/support" class="text-decoration-none">Safety Guidelines</a></div></div></footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
