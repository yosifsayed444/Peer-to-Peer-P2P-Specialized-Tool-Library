<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wallet - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/memberdashboard"><i class="fas fa-gauge-high"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/mytools"><i class="fas fa-toolbox"></i> My Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/mybookings"><i class="fas fa-calendar-check"></i> Bookings</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/Member/wallet"><i class="fas fa-wallet"></i> Wallet</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/notifications"><i class="fas fa-bell"></i> Alerts</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/profile"><i class="fas fa-user"></i> Profile</a></li>
                    <li class="nav-item"><button class="btn btn-outline-secondary"><i class="fas fa-sign-out-alt"></i> Logout</button></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h1 class="h2 fw-bold mb-1">Wallet & Escrow</h1>
                    <p class="text-muted mb-0">Track balance, deposits, refunds, and credits.</p>
                </div>
                <button class="btn btn-primary"><i class="fas fa-plus"></i> Add Funds</button>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Available Balance</div><div class="display-6 fw-bold">1,250 EGP</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Deposits Held</div><div class="display-6 fw-bold text-warning">500 EGP</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Pending Refunds</div><div class="display-6 fw-bold text-info">120 EGP</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Referral Credits</div><div class="display-6 fw-bold text-success">180 EGP</div></div></div></div>
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <h2 class="h5 mb-0">Transaction History</h2>
                            <div class="d-flex gap-2">
                                <select class="form-select form-select-sm" style="width:auto;"><option>All</option><option>Deposits</option><option>Payments</option><option>Refunds</option></select>
                                <a href="/Member/paymenthistory" class="btn btn-sm btn-outline-secondary">Full History</a>
                                <button class="btn btn-sm btn-outline-primary">Export</button>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr><th>Date</th><th>Description</th><th>Type</th><th>Amount</th><th>Status</th></tr>
                                </thead>
                                <tbody>
                                    <tr><td>Oct 24, 2026</td><td>Deposit released — booking #1008</td><td><span class="badge text-bg-success">Refund</span></td><td class="text-success">+50 EGP</td><td><span class="badge text-bg-success">Completed</span></td></tr>
                                    <tr><td>Oct 22, 2026</td><td>Rental payment — Cordless Drill</td><td><span class="badge text-bg-primary">Payment</span></td><td>−300 EGP</td><td><span class="badge text-bg-success">Completed</span></td></tr>
                                    <tr><td>Oct 20, 2026</td><td>Deposit held — booking #1012</td><td><span class="badge text-bg-warning text-dark">Deposit</span></td><td>−500 EGP</td><td><span class="badge text-bg-warning text-dark">Held</span></td></tr>
                                    <tr><td>Oct 18, 2026</td><td>Referral reward</td><td><span class="badge text-bg-info">Credit</span></td><td class="text-success">+100 EGP</td><td><span class="badge text-bg-success">Completed</span></td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Deposit Status</h2></div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span>Cordless Drill #1012</span><strong>500 EGP held</strong></div>
                            <div class="d-flex justify-content-between"><span>3D Printer #1015</span><strong class="text-warning">Pending</strong></div>
                        </div>
                    </div>
                    <div class="card shadow-sm">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Credits</h2></div>
                        <div class="card-body">
                            <p class="text-muted small mb-2">Referral credits are applied automatically at checkout.</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span>Available credits</span>
                                <strong>180 EGP</strong>
                            </div>
                            <button class="btn btn-outline-primary w-100 mt-3">View Referral History</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5">
        <div class="container text-center text-muted">
            <p class="mb-1">© 2024 ToolShare. All rights reserved.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a>
                <a href="/Home/terms" class="text-decoration-none">Terms of Service</a>
                <a href="/Home/support" class="text-decoration-none">Safety Guidelines</a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
