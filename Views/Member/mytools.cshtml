<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Tools - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/memberdashboard"><i class="fas fa-gauge-high"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/Member/mytools"><i class="fas fa-toolbox"></i> My Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/mybookings"><i class="fas fa-calendar-check"></i> Bookings</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/wallet"><i class="fas fa-wallet"></i> Wallet</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/notifications"><i class="fas fa-bell"></i> Alerts</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/profile"><i class="fas fa-user"></i> Profile</a></li>
                    <li class="nav-item"><button class="btn btn-outline-secondary"><i class="fas fa-sign-out-alt"></i> Logout</button></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h1 class="h2 fw-bold mb-1">My Tools</h1>
                    <p class="text-muted mb-0">Manage listings, pricing, availability, and maintenance status.</p>
                </div>
                <a href="/Member/addtool" class="btn btn-primary"><i class="fas fa-plus"></i> Add New Tool</a>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Total Tools</div><div class="display-6 fw-bold">4</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Available Now</div><div class="display-6 fw-bold text-success">3</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Currently Rented</div><div class="display-6 fw-bold text-primary">1</div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Needs Attention</div><div class="display-6 fw-bold text-warning">1</div></div></div></div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row g-3 mb-4">
                        <div class="col-md-4"><input type="text" class="form-control" placeholder="Search tools"></div>
                        <div class="col-md-3"><select class="form-select"><option>All statuses</option><option>Available</option><option>Rented</option><option>Maintenance</option><option>Locked</option></select></div>
                        <div class="col-md-3"><select class="form-select"><option>Sort by newest</option><option>Price high to low</option><option>Price low to high</option><option>Most bookings</option></select></div>
                        <div class="col-md-2"><button class="btn btn-outline-primary w-100"><i class="fas fa-filter"></i> Apply</button></div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Tool</th>
                                    <th>Category</th>
                                    <th>Price/Day</th>
                                    <th>Zone</th>
                                    <th>Status</th>
                                    <th>Rating</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><div class="d-flex align-items-center gap-2"><i class="fas fa-screwdriver-wrench text-primary"></i><div><div class="fw-semibold">Screwdriver Set</div><div class="text-muted small">Last updated 2 days ago</div></div></div></td>
                                    <td>Hand Tools</td>
                                    <td>20 EGP</td>
                                    <td>Heliopolis</td>
                                    <td><span class="badge text-bg-success">Available</span></td>
                                    <td><i class="fas fa-star text-warning"></i> 4.8</td>
                                    <td><a href="/Home/tooldetail" class="btn btn-sm btn-outline-primary">View</a> <a href="/Member/edittool" class="btn btn-sm btn-outline-secondary">Edit</a></td>
                                </tr>
                                <tr>
                                    <td><div class="d-flex align-items-center gap-2"><i class="fas fa-tree text-primary"></i><div><div class="fw-semibold">Garden Shears</div><div class="text-muted small">Battery health 71%</div></div></div></td>
                                    <td>Garden</td>
                                    <td>25 EGP</td>
                                    <td>Nasr City</td>
                                    <td><span class="badge text-bg-info">Rented</span></td>
                                    <td><i class="fas fa-star text-warning"></i> 4.7</td>
                                    <td><a href="/Home/tooldetail" class="btn btn-sm btn-outline-primary">View</a> <a href="/Maintenance/toolhealth" class="btn btn-sm btn-outline-warning">Health</a></td>
                                </tr>
                                <tr>
                                    <td><div class="d-flex align-items-center gap-2"><i class="fas fa-print text-primary"></i><div><div class="fw-semibold">3D Printer</div><div class="text-muted small">High value listing</div></div></div></td>
                                    <td>3D Printing</td>
                                    <td>150 EGP</td>
                                    <td>Zamalek</td>
                                    <td><span class="badge text-bg-warning text-dark">Pending Approval</span></td>
                                    <td><i class="fas fa-star text-warning"></i> 4.9</td>
                                    <td><a href="/Home/tooldetail" class="btn btn-sm btn-outline-primary">View</a> <a href="/Member/edittool" class="btn btn-sm btn-outline-secondary">Edit</a></td>
                                </tr>
                                <tr>
                                    <td><div class="d-flex align-items-center gap-2"><i class="fas fa-cog text-primary"></i><div><div class="fw-semibold">Angle Grinder</div><div class="text-muted small">Safety certificate expiring</div></div></div></td>
                                    <td>Power Tools</td>
                                    <td>60 EGP</td>
                                    <td>Dokki</td>
                                    <td><span class="badge text-bg-danger">Maintenance</span></td>
                                    <td><i class="fas fa-star text-warning"></i> 4.2</td>
                                    <td><a href="/Maintenance/toolhealth" class="btn btn-sm btn-outline-warning">Health</a> <a href="/Maintenance/disposal" class="btn btn-sm btn-outline-danger">Retire</a></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5">
        <div class="container text-center text-muted">
            <p class="mb-1">© 2024 ToolShare. All rights reserved.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a>
                <a href="/Home/terms" class="text-decoration-none">Terms of Service</a>
                <a href="/Home/support" class="text-decoration-none">Safety Guidelines</a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
