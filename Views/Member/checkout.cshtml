<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/memberdashboard"><i class="fas fa-gauge-high"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/mytools"><i class="fas fa-toolbox"></i> My Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/mybookings"><i class="fas fa-calendar-check"></i> Bookings</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/wallet"><i class="fas fa-wallet"></i> Wallet</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/notifications"><i class="fas fa-bell"></i> Alerts</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/profile"><i class="fas fa-user"></i> Profile</a></li>
                    <li class="nav-item"><button class="btn btn-outline-secondary"><i class="fas fa-sign-out-alt"></i> Logout</button></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            <div class="mb-4">
                <a href="/Home/tooldetail" class="btn btn-link px-0 text-decoration-none"><i class="fas fa-arrow-left me-1"></i> Back to Tool</a>
                <h1 class="h2 fw-bold mt-2 mb-1">Checkout</h1>
                <p class="text-muted mb-0">Review the booking details and complete the payment securely.</p>
            </div>

            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Booking Summary</h2></div>
                        <div class="card-body">
                            <div class="d-flex gap-3">
                                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width:72px;height:72px;flex:0 0 72px;"><i class="fas fa-tools fa-2x text-primary"></i></div>
                                <div>
                                    <div class="fw-semibold fs-5">Cordless Drill</div>
                                    <div class="text-muted small"><i class="fas fa-map-marker-alt"></i> Nasr City • Monika Adel</div>
                                    <div class="text-muted small">Oct 20 → Oct 24 • 4 days</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Handover Details</h2></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Pickup Date</label>
                                    <input type="date" class="form-control" value="2026-10-20">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Return Date</label>
                                    <input type="date" class="form-control" value="2026-10-24">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Pickup Time</label>
                                    <input type="time" class="form-control" value="17:30">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Return Time</label>
                                    <input type="time" class="form-control" value="17:30">
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Pickup Notes</label>
                                    <textarea class="form-control" rows="3" placeholder="Example: meet at the library desk"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Payment Method</h2></div>
                        <div class="card-body">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="payment" id="wallet" checked>
                                <label class="form-check-label" for="wallet">Wallet balance</label>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="radio" name="payment" id="card">
                                <label class="form-check-label" for="card">Card / Mobile payment</label>
                            </div>
                            <div class="alert alert-info mb-0">
                                <i class="fas fa-shield-alt"></i> Your deposit is held in escrow and released after return verification.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="card shadow-sm sticky-top" style="top: 90px;">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Price Breakdown</h2></div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2"><span>Rental (4 days)</span><strong>300 EGP</strong></div>
                            <div class="d-flex justify-content-between mb-2"><span>Insurance</span><strong>15 EGP</strong></div>
                            <div class="d-flex justify-content-between mb-2"><span>Platform fee</span><strong>25 EGP</strong></div>
                            <div class="d-flex justify-content-between mb-2"><span>Deposit held</span><strong>500 EGP</strong></div>
                            <hr>
                            <div class="d-flex justify-content-between mb-2"><span>Wallet credit</span><strong class="text-success">-50 EGP</strong></div>
                            <div class="d-flex justify-content-between fs-5 fw-bold"><span>Total due now</span><span>290 EGP</span></div>
                            <div class="text-muted small mt-1">Deposit will be refunded after verified return.</div>
                            <button class="btn btn-primary w-100 mt-3"><i class="fas fa-lock"></i> Confirm Booking</button>
                            <a href="/Member/mybookings" class="btn btn-outline-secondary w-100 mt-2">Cancel</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5">
        <div class="container text-center text-muted">
            <p class="mb-1">© 2024 ToolShare. All rights reserved.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a>
                <a href="/Home/terms" class="text-decoration-none">Terms of Service</a>
                <a href="/Home/support" class="text-decoration-none">Safety Guidelines</a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
