<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Handover - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/memberdashboard"><i class="fas fa-gauge-high"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/mytools"><i class="fas fa-toolbox"></i> My Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/mybookings"><i class="fas fa-calendar-check"></i> Bookings</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/wallet"><i class="fas fa-wallet"></i> Wallet</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/notifications"><i class="fas fa-bell"></i> Alerts</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/profile"><i class="fas fa-user"></i> Profile</a></li>
                    <li class="nav-item"><button class="btn btn-outline-secondary"><i class="fas fa-sign-out-alt"></i> Logout</button></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            <div class="mb-4">
                <a href="/Member/bookingdetail" class="btn btn-link px-0 text-decoration-none"><i class="fas fa-arrow-left me-1"></i> Back to Booking</a>
                <h1 class="h2 fw-bold mt-2 mb-1">QR Handover</h1>
                <p class="text-muted mb-0">Scan the QR code at pickup or return to confirm the physical handover.</p>
            </div>

            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="card shadow-sm text-center">
                        <div class="card-body p-4">
                            <div class="bg-light rounded p-4 mb-3">
                                <i class="fas fa-qrcode fa-6x text-primary"></i>
                            </div>
                            <h2 class="h4">Booking #1012</h2>
                            <p class="text-muted mb-1">Cordless Drill</p>
                            <p class="text-muted mb-3">Oct 20, 2026 • 5:30 PM</p>
                            <div class="alert alert-info text-start">
                                <i class="fas fa-shield-alt"></i> This QR code is unique to this booking and cannot be reused.
                            </div>
                            <button class="btn btn-primary w-100"><i class="fas fa-camera"></i> Scan QR Code</button>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Handover Checklist</h2></div>
                        <div class="card-body">
                            <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="check1"><label class="form-check-label" for="check1">Tool matches the listing photos</label></div>
                            <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="check2"><label class="form-check-label" for="check2">Accessories and cables included</label></div>
                            <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="check3"><label class="form-check-label" for="check3">No visible damage before handover</label></div>
                            <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="check4"><label class="form-check-label" for="check4">Both parties present and verified</label></div>
                            <button class="btn btn-success w-100"><i class="fas fa-check"></i> Confirm Handover</button>
                        </div>
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Handover Photos</h2></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Pickup Photo</label>
                                    <input type="file" class="form-control">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Return Photo</label>
                                    <input type="file" class="form-control">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5">
        <div class="container text-center text-muted">
            <p class="mb-1">© 2024 ToolShare. All rights reserved.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a>
                <a href="/Home/terms" class="text-decoration-none">Terms of Service</a>
                <a href="/Home/support" class="text-decoration-none">Safety Guidelines</a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
