<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link rel="stylesheet" href="/css/dashboard.css?v=2">
    <link rel="stylesheet" href="/css/components.css">
    <style>
        /* Function number badge next to sidebar items */
        .sidebar-item .fn-num {
            background: var(--light-color);
            border: 1px solid var(--border-color);
            color: var(--secondary-color);
            border-radius: 4px;
            font-size: 0.6rem;
            font-weight: 700;
            width: 1.5rem;
            text-align: center;
            flex-shrink: 0;
            font-family: monospace;
        }
        .sidebar-item .fn-name {
            font-size: 0.82rem;
        }
    </style>
</head>
<body>
    <!-- Navbar (authenticated template) -->
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/Home/Index" class="logo">
                <i class="fas fa-tools"></i>
                <span>ToolShare</span>
            </a>
            <button class="mobile-menu-btn" id="mobile-menu-btn">
                <i class="fas fa-bars"></i>
            </button>
            <div class="nav-menu" id="nav-menu">
                <a href="/Home/Index" class="nav-link"><i class="fas fa-home"></i> Home</a>
                <a href="/Home/tools" class="nav-link"><i class="fas fa-search"></i> Browse Tools</a>
                <a href="/Admin/admindashboard" class="nav-link"><i class="fas fa-crown"></i> Admin Panel</a>
                <a href="/Home/profile" class="nav-link"><i class="fas fa-user"></i> Profile</a>
                <button class="btn btn-outline"><i class="fas fa-sign-out-alt"></i> Logout</button>
            </div>
        </div>
    </nav>

    <div class="dashboard-container">
        <!-- Sidebar : الـ 3 وحدات الأساسية والـ 42 وظيفة من محضر المشروع -->
        <aside class="dashboard-sidebar">
            <div class="sidebar-nav" id="sidebar-nav"></div>
        </aside>

        <!-- Main area -->
        <main class="dashboard-main">
            <h1><i class="fas fa-chart-line"></i> Dashboard Overview</h1>

            <!-- Stats -->
            <div class="stats-grid">
                <div class="stat-card stat-card-primary">
                    <div class="stat-icon"><i class="fas fa-users"></i></div>
                    <div class="stat-value">156</div>
                    <div class="stat-label">Total Users</div>
                </div>
                <div class="stat-card stat-card-success">
                    <div class="stat-icon"><i class="fas fa-tools"></i></div>
                    <div class="stat-value">89</div>
                    <div class="stat-label">Total Tools</div>
                </div>
                <div class="stat-card stat-card-warning">
                    <div class="stat-icon"><i class="fas fa-calendar-check"></i></div>
                    <div class="stat-value">234</div>
                    <div class="stat-label">Total Bookings</div>
                </div>
                <div class="stat-card stat-card-danger">
                    <div class="stat-icon"><i class="fas fa-exclamation-triangle"></i></div>
                    <div class="stat-value">7</div>
                    <div class="stat-label">Pending Reports</div>
                </div>
            </div>

            <!-- Function coverage summary -->
            <div class="card">
                <div class="card-header"><i class="fas fa-th-large"></i> Function Coverage — 3 Operation Units / 42 Functions</div>
                <div class="card-body table-container">
                    <table class="data-table">
                        <thead>
                            <tr><th>Unit</th><th>Functions</th><th>Focus</th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><i class="fas fa-user"></i> <strong>Members Unit</strong></td>
                                <td><span class="badge badge-primary">1–14</span></td>
                                <td>Lender &amp; borrower accounts, bookings, payments, ratings</td>
                            </tr>
                            <tr>
                                <td><i class="fas fa-clipboard"></i> <strong>Library Unit</strong></td>
                                <td><span class="badge badge-primary">15–28</span></td>
                                <td>Supervision, dispute resolution, auditing, financial reports</td>
                            </tr>
                            <tr>
                                <td><i class="fas fa-tools"></i> <strong>Maintenance Unit</strong></td>
                                <td><span class="badge badge-primary">29–42</span></td>
                                <td>Tool health, safety certificates, repair history</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Quick actions -->
            <div class="quick-actions">
                <a href="/Member/addtool" class="quick-action-card">
                    <div class="quick-action-icon"><i class="fas fa-plus-circle"></i></div>
                    <div>Add New Tool</div>
                </a>
                <a href="/Library/adduser" class="quick-action-card">
                    <div class="quick-action-icon"><i class="fas fa-user-plus"></i></div>
                    <div>Add New User</div>
                </a>
                <a href="/Library/reports" class="quick-action-card">
                    <div class="quick-action-icon"><i class="fas fa-chart-bar"></i></div>
                    <div>Generate Report</div>
                </a>
            </div>

            <!-- Users by role -->
            <div class="card">
                <div class="card-header">Users by Role</div>
                <div class="card-body table-container">
                    <table class="data-table">
                        <thead>
                            <tr><th>Role</th><th>Count</th></tr>
                        </thead>
                        <tbody>
                            <tr><td><span class="badge badge-info">member</span></td><td>120</td></tr>
                            <tr><td><span class="badge badge-primary">librarian</span></td><td>8</td></tr>
                            <tr><td><span class="badge badge-warning">technician</span></td><td>6</td></tr>
                            <tr><td><span class="badge badge-success">admin</span></td><td>2</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Recent bookings -->
            <div class="card">
                <div class="card-header">Recent Bookings</div>
                <div class="card-body table-container">
                    <table class="data-table">
                        <thead>
                            <tr><th>ID</th><th>Tool</th><th>Borrower</th><th>Status</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>#1012</td>
                                <td>Cordless Drill</td>
                                <td>Ahmed Hassan</td>
                                <td><span class="badge badge-success">confirmed</span></td>
                                <td>
                                    <button class="btn-icon view"><i class="fas fa-eye"></i></button>
                                    <button class="btn-icon edit"><i class="fas fa-edit"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td>#1011</td>
                                <td>Screwdriver Set</td>
                                <td>Sara Mostafa</td>
                                <td><span class="badge badge-warning">pending</span></td>
                                <td>
                                    <button class="btn-icon view"><i class="fas fa-eye"></i></button>
                                    <button class="btn-icon edit"><i class="fas fa-edit"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td>#1010</td>
                                <td>Angle Grinder</td>
                                <td>Omar Ali</td>
                                <td><span class="badge badge-info">active</span></td>
                                <td>
                                    <button class="btn-icon view"><i class="fas fa-eye"></i></button>
                                    <button class="btn-icon edit"><i class="fas fa-edit"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- Mobile menu toggle (UI plumbing only) -->
    <script>
        document.getElementById('mobile-menu-btn').addEventListener('click', function () {
            document.getElementById('nav-menu').classList.toggle('active');
        });
    </script>
    <script src="/js/functions-data.js"></script>
    <script src="/js/sidebar.js"></script>
    <script>renderSidebar('admin', 'admin-dashboard.html');</script>
    <script src="/js/dashboard-ui.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
