<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Settings - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="fas fa-crown"></i> Admin Panel</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/Admin/admindashboard"><i class="fas fa-chart-line"></i> Dashboard</a></li>
                            <li><a class="dropdown-item" href="/Admin/adminsettings"><i class="fas fa-cog"></i> Settings</a></li>
                            <li><a class="dropdown-item" href="/Admin/rolemanagement"><i class="fas fa-user-shield"></i> Roles</a></li>
                            <li><a class="dropdown-item" href="/Admin/auditlog"><i class="fas fa-history"></i> Audit Log</a></li>
                            <li><a class="dropdown-item" href="/Library/reports"><i class="fas fa-chart-bar"></i> Reports</a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><button class="btn btn-outline-secondary"><i class="fas fa-sign-out-alt"></i> Logout</button></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            <div class="mb-4">
                <a href="/Admin/admindashboard" class="btn btn-link px-0 text-decoration-none"><i class="fas fa-arrow-left me-1"></i> Back to Dashboard</a>
                <h1 class="h2 fw-bold mt-2 mb-1"><i class="fas fa-cog text-primary me-2"></i>Admin Settings</h1>
                <p class="text-muted mb-0">Configure platform defaults, fees, notifications, and safety rules.</p>
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Platform Configuration</h2></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6"><label class="form-label">Platform Commission %</label><input type="number" class="form-control" value="18"></div>
                                <div class="col-md-6"><label class="form-label">Insurance %</label><input type="number" class="form-control" value="5"></div>
                                <div class="col-md-6"><label class="form-label">Default Deposit %</label><input type="number" class="form-control" value="20"></div>
                                <div class="col-md-6"><label class="form-label">Max Borrow Days</label><input type="number" class="form-control" value="7"></div>
                                <div class="col-md-6"><label class="form-label">Cleaning Buffer (hours)</label><input type="number" class="form-control" value="10"></div>
                                <div class="col-md-6"><label class="form-label">Late Return Grace (hours)</label><input type="number" class="form-control" value="2"></div>
                            </div>
                        </div>
                    </div>
                    <div class="card shadow-sm">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Notifications</h2></div>
                        <div class="card-body">
                            <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="n1" checked><label class="form-check-label" for="n1">Email booking confirmations</label></div>
                            <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="n2" checked><label class="form-check-label" for="n2">SMS late return alerts</label></div>
                            <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="n3"><label class="form-check-label" for="n3">Push notifications</label></div>
                            <div class="form-check"><input class="form-check-input" type="checkbox" id="n4" checked><label class="form-check-label" for="n4">Weekly maintenance reminders</label></div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Danger Zone</h2></div>
                        <div class="card-body">
                            <button class="btn btn-outline-danger w-100 mb-2"><i class="fas fa-trash"></i> Clear test data</button>
                            <button class="btn btn-outline-warning w-100"><i class="fas fa-pause"></i> Pause platform</button>
                        </div>
                    </div>
                    <button class="btn btn-primary w-100"><i class="fas fa-save"></i> Save Settings</button>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5"><div class="container text-center text-muted"><p class="mb-1">© 2024 ToolShare. All rights reserved.</p><div class="d-flex justify-content-center gap-3"><a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a><a href="/Home/terms" class="text-decoration-none">Terms of Service</a><a href="/Home/support" class="text-decoration-none">Safety Guidelines</a></div></div></footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
