<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tool Health - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/memberdashboard"><i class="fas fa-gauge-high"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/Member/mytools"><i class="fas fa-toolbox"></i> My Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/mybookings"><i class="fas fa-calendar-check"></i> Bookings</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/wallet"><i class="fas fa-wallet"></i> Wallet</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/notifications"><i class="fas fa-bell"></i> Alerts</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/profile"><i class="fas fa-user"></i> Profile</a></li>
                    <li class="nav-item"><button class="btn btn-outline-secondary"><i class="fas fa-sign-out-alt"></i> Logout</button></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            <div class="mb-4">
                <a href="/Member/mytools" class="btn btn-link px-0 text-decoration-none"><i class="fas fa-arrow-left me-1"></i> Back to My Tools</a>
                <h1 class="h2 fw-bold mt-2 mb-1">Garden Shears — Tool Health</h1>
                <p class="text-muted mb-0">Usage, battery, safety certificate, and maintenance history.</p>
            </div>

            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card shadow-sm mb-4">
                        <div class="card-body text-center">
                            <div class="bg-light rounded p-4 mb-3"><i class="fas fa-tree fa-4x text-primary"></i></div>
                            <h2 class="h5">Garden Shears</h2>
                            <span class="badge text-bg-info">Rented</span>
                            <div class="mt-3">
                                <div class="text-muted small">Battery Health</div>
                                <div class="display-6 fw-bold text-warning">71%</div>
                                <div class="progress" style="height:8px;"><div class="progress-bar bg-warning" style="width:71%;"></div></div>
                            </div>
                        </div>
                    </div>
                    <div class="card shadow-sm">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Next Maintenance</h2></div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2"><span>Battery replacement</span><strong>Recommended</strong></div>
                            <div class="d-flex justify-content-between"><span>Safety check</span><strong>Due in 18 days</strong></div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Usage Summary</h2></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4"><div class="border rounded p-3 text-center"><div class="text-muted small">Total Rentals</div><div class="display-6 fw-bold">32</div></div></div>
                                <div class="col-md-4"><div class="border rounded p-3 text-center"><div class="text-muted small">Usage Hours</div><div class="display-6 fw-bold">186</div></div></div>
                                <div class="col-md-4"><div class="border rounded p-3 text-center"><div class="text-muted small">Last Service</div><div class="display-6 fw-bold">Sep 12</div></div></div>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Maintenance History</h2></div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead><tr><th>Date</th><th>Type</th><th>Technician</th><th>Status</th><th>Notes</th></tr></thead>
                                <tbody>
                                    <tr><td>Sep 12, 2026</td><td>Routine inspection</td><td>Mahmoud Samir</td><td><span class="badge text-bg-success">Passed</span></td><td>Blade sharpened</td></tr>
                                    <tr><td>Aug 02, 2026</td><td>Battery check</td><td>Youssef Nabil</td><td><span class="badge text-bg-warning text-dark">Needs attention</span></td><td>Health dropped to 71%</td></tr>
                                    <tr><td>Jun 18, 2026</td><td>Cleaning</td><td>Mahmoud Samir</td><td><span class="badge text-bg-success">Completed</span></td><td>Full cleaning</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5">
        <div class="container text-center text-muted">
            <p class="mb-1">© 2024 ToolShare. All rights reserved.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a>
                <a href="/Home/terms" class="text-decoration-none">Terms of Service</a>
                <a href="/Home/support" class="text-decoration-none">Safety Guidelines</a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
