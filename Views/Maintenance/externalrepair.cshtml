<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>External Repair - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="fas fa-screwdriver-wrench"></i> Maintenance Panel</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/Maintenance/maintenancedashboard"><i class="fas fa-gauge-high"></i> Dashboard</a></li>
                            <li><a class="dropdown-item" href="/Maintenance/toolhealth"><i class="fas fa-heart-pulse"></i> Tool Health</a></li>
                            <li><a class="dropdown-item" href="/Maintenance/externalrepair"><i class="fas fa-external-link-alt"></i> External Repair</a></li>
                            <li><a class="dropdown-item" href="/Maintenance/disposal"><i class="fas fa-recycle"></i> Disposal</a></li>
                            <li><a class="dropdown-item" href="/Maintenance/maintenancehistory"><i class="fas fa-history"></i> History</a></li>
                            <li><a class="dropdown-item" href="/Maintenance/technicianmetrics"><i class="fas fa-chart-line"></i> Metrics</a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><button class="btn btn-outline-secondary"><i class="fas fa-sign-out-alt"></i> Logout</button></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            <div class="mb-4">
                <a href="/Maintenance/maintenancedashboard" class="btn btn-link px-0 text-decoration-none"><i class="fas fa-arrow-left me-1"></i> Back to Dashboard</a>
                <h1 class="h2 fw-bold mt-2 mb-1">External Repair Tracking</h1>
                <p class="text-muted mb-0">Manage tools sent to external repair centers.</p>
            </div>

            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">New External Repair</h2></div>
                        <div class="card-body">
                            <form>
                                <div class="row g-3">
                                    <div class="col-md-6"><label class="form-label">Tool</label><select class="form-select"><option>Cordless Drill</option><option>3D Printer</option><option>Angle Grinder</option></select></div>
                                    <div class="col-md-6"><label class="form-label">Repair Center</label><input type="text" class="form-control" placeholder="Example: Bosch Service Center"></div>
                                    <div class="col-md-6"><label class="form-label">Sent Date</label><input type="date" class="form-control"></div>
                                    <div class="col-md-6"><label class="form-label">Expected Return</label><input type="date" class="form-control"></div>
                                    <div class="col-12"><label class="form-label">Problem Description</label><textarea class="form-control" rows="3"></textarea></div>
                                    <div class="col-12"><label class="form-label">Invoice / Report</label><input type="file" class="form-control"></div>
                                </div>
                                <button type="button" class="btn btn-primary mt-3"><i class="fas fa-paper-plane"></i> Send for Repair</button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Current External Repairs</h2></div>
                        <div class="list-group list-group-flush">
                            <div class="list-group-item"><div class="d-flex justify-content-between"><strong>Cordless Drill</strong><span class="badge text-bg-info">In Inspecting</span></div><div class="text-muted small">Bosch Service Center • Sent Oct 18 • Expected Oct 25</div></div>
                            <div class="list-group-item"><div class="d-flex justify-content-between"><strong>Angle Grinder</strong><span class="badge text-bg-warning text-dark">Waiting parts</span></div><div class="text-muted small">Local Workshop • Sent Oct 15 • Expected Oct 28</div></div>
                        </div>
                    </div>
                    <div class="alert alert-info"><i class="fas fa-info-circle"></i> Tools sent externally are automatically locked from new bookings.</div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5">
        <div class="container text-center text-muted">
            <p class="mb-1">© 2024 ToolShare. All rights reserved.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a>
                <a href="/Home/terms" class="text-decoration-none">Terms of Service</a>
                <a href="/Home/support" class="text-decoration-none">Safety Guidelines</a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
