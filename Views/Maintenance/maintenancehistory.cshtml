<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Maintenance History - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="fas fa-screwdriver-wrench"></i> Maintenance Panel</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/Maintenance/maintenancedashboard"><i class="fas fa-gauge-high"></i> Dashboard</a></li>
                            <li><a class="dropdown-item" href="/Maintenance/toolhealth"><i class="fas fa-heart-pulse"></i> Tool Health</a></li>
                            <li><a class="dropdown-item" href="/Maintenance/externalrepair"><i class="fas fa-external-link-alt"></i> External Repair</a></li>
                            <li><a class="dropdown-item" href="/Maintenance/disposal"><i class="fas fa-recycle"></i> Disposal</a></li>
                            <li><a class="dropdown-item" href="/Maintenance/maintenancehistory"><i class="fas fa-history"></i> History</a></li>
                            <li><a class="dropdown-item" href="/Maintenance/technicianmetrics"><i class="fas fa-chart-line"></i> Metrics</a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><button class="btn btn-outline-secondary"><i class="fas fa-sign-out-alt"></i> Logout</button></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            <div class="mb-4">
                <a href="/Maintenance/maintenancedashboard" class="btn btn-link px-0 text-decoration-none"><i class="fas fa-arrow-left me-1"></i> Back to Dashboard</a>
                <h1 class="h2 fw-bold mt-2 mb-1">Maintenance History</h1>
                <p class="text-muted mb-0">Public service log for all tools to build borrower trust.</p>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4"><input type="text" class="form-control" placeholder="Search tool"></div>
                        <div class="col-md-3"><select class="form-select"><option>All types</option><option>Inspection</option><option>Repair</option><option>Cleaning</option><option>Battery</option></select></div>
                        <div class="col-md-3"><input type="date" class="form-control"></div>
                        <div class="col-md-2"><button class="btn btn-outline-primary w-100"><i class="fas fa-filter"></i> Apply</button></div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead><tr><th>Date</th><th>Tool</th><th>Type</th><th>Technician</th><th>Status</th><th>Notes</th></tr></thead>
                            <tbody>
                                <tr><td>Oct 10, 2026</td><td>Cordless Drill</td><td>Inspection</td><td>Mahmoud Samir</td><td><span class="badge text-bg-success">Passed</span></td><td>Routine check</td></tr>
                                <tr><td>Oct 05, 2026</td><td>3D Printer</td><td>Repair</td><td>Youssef Nabil</td><td><span class="badge text-bg-info">Completed</span></td><td>Nozzle replaced</td></tr>
                                <tr><td>Sep 28, 2026</td><td>Garden Shears</td><td>Battery</td><td>Mahmoud Samir</td><td><span class="badge text-bg-warning text-dark">Needs attention</span></td><td>Health 71%</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5">
        <div class="container text-center text-muted">
            <p class="mb-1">© 2024 ToolShare. All rights reserved.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a>
                <a href="/Home/terms" class="text-decoration-none">Terms of Service</a>
                <a href="/Home/support" class="text-decoration-none">Safety Guidelines</a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
