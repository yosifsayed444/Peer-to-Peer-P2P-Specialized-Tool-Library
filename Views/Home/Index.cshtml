<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link rel="stylesheet" href="/css/dashboard.css?v=2">
    <link rel="stylesheet" href="/css/components.css">
</head>
<body>
    <div id="app">
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item"><a class="nav-link active" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                        <li class="nav-item"><a class="btn btn-outline-primary" href="/Home/login">Login</a></li>
                        <li class="nav-item"><a class="btn btn-primary" href="/Home/register">Register</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <main class="py-5">
            <div class="container">
                <div class="p-5 mb-4 rounded-4 text-white" style="background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));">
                    <div class="row align-items-center g-4">
                        <div class="col-lg-7">
                            <h1 class="display-5 fw-bold">Welcome to P2P Tool Library</h1>
                            <p class="lead mb-4">Borrow tools from your neighbors or earn money by lending yours.</p>
                            <div class="d-flex flex-wrap gap-2">
                                <a href="/Home/tools" class="btn btn-light btn-lg"><i class="fas fa-search"></i> Browse Tools</a>
                                <a href="/Member/memberdashboard" class="btn btn-outline-light btn-lg"><i class="fas fa-gauge-high"></i> Member Dashboard</a>
                            </div>
                        </div>
                        <div class="col-lg-5 text-center">
                            <i class="fas fa-tools" style="font-size: 8rem; opacity: 0.15;"></i>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h4 fw-bold mb-0">Featured Tools</h2>
                    <a href="/Home/tools" class="btn btn-sm btn-outline-primary">View all</a>
                </div>
                <div class="row g-4">
                    <div class="col-xl-3 col-lg-4 col-md-6">
                        <div class="card h-100 tool-card shadow-sm">
                            <div class="bg-light text-center py-4 rounded-top"><i class="fas fa-tools fa-3x text-primary"></i></div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2"><h3 class="h5 mb-0">Cordless Drill</h3><span class="badge text-bg-success">Available</span></div>
                                <div class="text-muted small mb-2"><i class="fas fa-map-marker-alt text-primary me-1"></i> Nasr City</div>
                                <div class="mb-2"><span class="text-warning">★★★★★</span> <span class="text-muted small">(4.9)</span></div>
                                <div class="fw-bold text-primary fs-5">75 EGP/day</div>
                            </div>
                            <div class="card-footer bg-white"><a href="/Home/tooldetail" class="btn btn-primary w-100"><i class="fas fa-calendar-check"></i> View & Book</a></div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-4 col-md-6">
                        <div class="card h-100 tool-card shadow-sm">
                            <div class="bg-light text-center py-4 rounded-top"><i class="fas fa-hammer fa-3x text-primary"></i></div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2"><h3 class="h5 mb-0">Claw Hammer</h3><span class="badge text-bg-success">Available</span></div>
                                <div class="text-muted small mb-2"><i class="fas fa-map-marker-alt text-primary me-1"></i> Maadi</div>
                                <div class="mb-2"><span class="text-warning">★★★★☆</span> <span class="text-muted small">(4.4)</span></div>
                                <div class="fw-bold text-primary fs-5">15 EGP/day</div>
                            </div>
                            <div class="card-footer bg-white"><a href="/Home/tooldetail" class="btn btn-primary w-100"><i class="fas fa-calendar-check"></i> View & Book</a></div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-4 col-md-6">
                        <div class="card h-100 tool-card shadow-sm">
                            <div class="bg-light text-center py-4 rounded-top"><i class="fas fa-screwdriver-wrench fa-3x text-primary"></i></div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2"><h3 class="h5 mb-0">Screwdriver Set</h3><span class="badge text-bg-success">Available</span></div>
                                <div class="text-muted small mb-2"><i class="fas fa-map-marker-alt text-primary me-1"></i> Heliopolis</div>
                                <div class="mb-2"><span class="text-warning">★★★★★</span> <span class="text-muted small">(4.8)</span></div>
                                <div class="fw-bold text-primary fs-5">20 EGP/day</div>
                            </div>
                            <div class="card-footer bg-white"><a href="/Home/tooldetail" class="btn btn-primary w-100"><i class="fas fa-calendar-check"></i> View & Book</a></div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-4 col-md-6">
                        <div class="card h-100 tool-card shadow-sm">
                            <div class="bg-light text-center py-4 rounded-top"><i class="fas fa-cog fa-3x text-primary"></i></div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2"><h3 class="h5 mb-0">Angle Grinder</h3><span class="badge text-bg-info">Rented</span></div>
                                <div class="text-muted small mb-2"><i class="fas fa-map-marker-alt text-primary me-1"></i> Dokki</div>
                                <div class="mb-2"><span class="text-warning">★★★★☆</span> <span class="text-muted small">(4.2)</span></div>
                                <div class="fw-bold text-primary fs-5">60 EGP/day</div>
                            </div>
                            <div class="card-footer bg-white"><button class="btn btn-outline-primary w-100" disabled>Currently Rented</button></div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-4 col-md-6">
                        <div class="card h-100 tool-card shadow-sm">
                            <div class="bg-light text-center py-4 rounded-top"><i class="fas fa-tree fa-3x text-primary"></i></div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2"><h3 class="h5 mb-0">Garden Shears</h3><span class="badge text-bg-success">Available</span></div>
                                <div class="text-muted small mb-2"><i class="fas fa-map-marker-alt text-primary me-1"></i> Nasr City</div>
                                <div class="mb-2"><span class="text-warning">★★★★★</span> <span class="text-muted small">(4.7)</span></div>
                                <div class="fw-bold text-primary fs-5">25 EGP/day</div>
                            </div>
                            <div class="card-footer bg-white"><a href="/Home/tooldetail" class="btn btn-primary w-100"><i class="fas fa-calendar-check"></i> View & Book</a></div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-4 col-md-6">
                        <div class="card h-100 tool-card shadow-sm">
                            <div class="bg-light text-center py-4 rounded-top"><i class="fas fa-print fa-3x text-primary"></i></div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2"><h3 class="h5 mb-0">3D Printer</h3><span class="badge text-bg-warning text-dark">High Value</span></div>
                                <div class="text-muted small mb-2"><i class="fas fa-map-marker-alt text-primary me-1"></i> Zamalek</div>
                                <div class="mb-2"><span class="text-warning">★★★★★</span> <span class="text-muted small">(4.9)</span></div>
                                <div class="fw-bold text-primary fs-5">150 EGP/day</div>
                            </div>
                            <div class="card-footer bg-white"><a href="/Home/tooldetail" class="btn btn-primary w-100"><i class="fas fa-calendar-check"></i> View & Book</a></div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <footer class="footer py-4 mt-5">
            <div class="container text-center text-muted">
                <p class="mb-1">© 2024 ToolShare. All rights reserved.</p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a>
                    <a href="/Home/terms" class="text-decoration-none">Terms of Service</a>
                    <a href="/Home/support" class="text-decoration-none">Safety Guidelines</a>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
