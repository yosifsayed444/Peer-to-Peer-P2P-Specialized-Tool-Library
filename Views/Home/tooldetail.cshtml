<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tool Details - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link rel="stylesheet" href="/css/dashboard.css?v=2">
    <link rel="stylesheet" href="/css/components.css">
</head>
<body>
    <div id="app">
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                        <li class="nav-item"><a class="nav-link active" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                        <li class="nav-item"><a class="btn btn-outline-primary" href="/Home/login">Login</a></li>
                        <li class="nav-item"><a class="btn btn-primary" href="/Home/register">Register</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <main class="py-5">
            <div class="container">
                <div class="mb-4">
                    <a href="/Home/tools" class="btn btn-link px-0 text-decoration-none"><i class="fas fa-arrow-left me-1"></i> Back to Tools</a>
                </div>

                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="card shadow-sm overflow-hidden">
                            <div class="bg-light text-center py-5">
                                <i class="fas fa-tools fa-6x text-primary"></i>
                            </div>
                            <div class="card-body">
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge text-bg-warning"><i class="fas fa-star"></i> Top Rated</span>
                                    <span class="badge text-bg-success">Available</span>
                                    <span class="badge text-bg-info">Power Tools</span>
                                </div>

                                <ul class="nav nav-tabs mt-4" id="toolTabs" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#overview" type="button">Overview</button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#specs" type="button">Specifications</button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#documents" type="button">Documents</button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#maintenance" type="button">Maintenance</button>
                                    </li>
                                </ul>

                                <div class="tab-content pt-3">
                                    <div class="tab-pane fade show active" id="overview">
                                        <h2 class="h4">Cordless Drill</h2>
                                        <p class="text-muted"><i class="fas fa-map-marker-alt text-primary me-1"></i> Nasr City • 1.2 km away</p>
                                        <p>Powerful 18V cordless drill suitable for home projects. Comes with two batteries and a charger. Ideal for drilling, screw driving, and light renovation work.</p>
                                        <div class="alert alert-success d-flex align-items-center gap-2">
                                            <i class="fas fa-shield-alt"></i>
                                            <div>Safety certificate and usage manual attached. Last maintenance: 2026-09-18.</div>
                                        </div>
                                    </div>
                                    <div class="tab-pane fade" id="specs">
                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item d-flex justify-content-between"><span>Brand</span><strong>Bosch</strong></li>
                                            <li class="list-group-item d-flex justify-content-between"><span>Voltage</span><strong>18V</strong></li>
                                            <li class="list-group-item d-flex justify-content-between"><span>Battery Health</span><strong>82%</strong></li>
                                            <li class="list-group-item d-flex justify-content-between"><span>Warranty Expiry</span><strong>2027-04-12</strong></li>
                                            <li class="list-group-item d-flex justify-content-between"><span>Compatible Bits</span><strong>Wood, Metal, Masonry</strong></li>
                                        </ul>
                                    </div>
                                    <div class="tab-pane fade" id="documents">
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <div class="border rounded p-3 h-100">
                                                    <i class="fas fa-file-pdf fa-2x text-danger mb-2"></i>
                                                    <div class="fw-semibold">User Manual</div>
                                                    <div class="text-muted small">PDF • 1.2 MB</div>
                                                    <button class="btn btn-sm btn-outline-primary mt-2">Download</button>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="border rounded p-3 h-100">
                                                    <i class="fas fa-video fa-2x text-primary mb-2"></i>
                                                    <div class="fw-semibold">Safety Video</div>
                                                    <div class="text-muted small">MP4 • 2:18</div>
                                                    <button class="btn btn-sm btn-outline-primary mt-2">Watch</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tab-pane fade" id="maintenance">
                                        <div class="timeline">
                                            <div class="d-flex gap-3 mb-3">
                                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:36px;height:36px;flex:0 0 36px;"><i class="fas fa-check"></i></div>
                                                <div><strong>Routine inspection</strong><div class="text-muted small">2026-09-18 • Passed</div></div>
                                            </div>
                                            <div class="d-flex gap-3 mb-3">
                                                <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center" style="width:36px;height:36px;flex:0 0 36px;"><i class="fas fa-battery-half"></i></div>
                                                <div><strong>Battery health check</strong><div class="text-muted small">2026-08-22 • 82%</div></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="card shadow-sm mb-4">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h1 class="h3 mb-1">Cordless Drill</h1>
                                        <div class="text-muted"><i class="fas fa-star text-warning"></i> 4.9 (34 reviews)</div>
                                    </div>
                                    <span class="badge text-bg-success fs-6">Available</span>
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col-4">
                                        <div class="border rounded p-2 text-center h-100">
                                            <div class="fw-bold">Hourly</div>
                                            <div>10 EGP</div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="border rounded p-2 text-center h-100 bg-light">
                                            <div class="fw-bold">Daily</div>
                                            <div class="text-primary fw-bold">75 EGP</div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="border rounded p-2 text-center h-100">
                                            <div class="fw-bold">Weekly</div>
                                            <div>400 EGP</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="list-group mb-3">
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span><i class="fas fa-shield-alt text-primary me-2"></i>Deposit</span>
                                        <strong>500 EGP</strong>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span><i class="fas fa-file-invoice text-primary me-2"></i>Insurance</span>
                                        <strong>5% of rental</strong>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span><i class="fas fa-calendar-alt text-primary me-2"></i>Max borrow</span>
                                        <strong>7 days</strong>
                                    </div>
                                </div>

                                <form>
                                    <div class="row g-3">
                                        <div class="col-6">
                                            <label class="form-label">Pickup Date</label>
                                            <input type="date" class="form-control">
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label">Return Date</label>
                                            <input type="date" class="form-control">
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-primary w-100 mt-3" data-bs-toggle="modal" data-bs-target="#bookingModal">
                                        <i class="fas fa-calendar-check"></i> Continue to Booking
                                    </button>
                                    <a href="/Home/messages" class="btn btn-outline-secondary w-100 mt-2">
                                        <i class="fas fa-comment-dots"></i> Ask the owner
                                    </a>
                                    <a href="/Member/bookingcalendar" class="btn btn-link w-100 mt-1 text-decoration-none">
                                        <i class="fas fa-calendar-days"></i> View availability calendar
                                    </a>
                                </form>
                            </div>
                        </div>

                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h2 class="h5">Owner</h2>
                                <a href="/Home/userprofilepublic" class="d-flex align-items-center gap-3 text-decoration-none text-dark">
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:48px;height:48px;">MA</div>
                                    <div>
                                        <div class="fw-semibold">Monika Adel</div>
                                        <div class="text-muted small"><i class="fas fa-crown text-warning"></i> Pro Member • Trust 92</div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <div class="modal fade" id="bookingModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm Booking</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-2"><strong>Tool:</strong> Cordless Drill</p>
                        <p class="mb-2"><strong>Dates:</strong> Selected dates</p>
                        <p class="mb-0"><strong>Total:</strong> 300 EGP + 500 EGP deposit</p>
                        <div class="alert alert-info mt-3 mb-0">Availability includes a cleaning buffer after each rental.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <a href="/Member/checkout" class="btn btn-primary">Continue to Payment</a>
                    </div>
                </div>
            </div>
        </div>

        <footer class="footer py-4 mt-5">
            <div class="container text-center text-muted">
                <p class="mb-1">© 2024 ToolShare. All rights reserved.</p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a>
                    <a href="/Home/terms" class="text-decoration-none">Terms of Service</a>
                    <a href="/Home/support" class="text-decoration-none">Safety Guidelines</a>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
