<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link rel="stylesheet" href="/css/dashboard.css?v=2">
    <link rel="stylesheet" href="/css/components.css">
</head>
<body>
    <div id="app">
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                        <li class="nav-item"><a class="btn btn-outline-primary" href="/Home/login">Login</a></li>
                        <li class="nav-item"><a class="btn btn-primary" href="/Home/register">Register</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <main class="py-5">
            <div class="container">
                <div class="row justify-content-center align-items-center min-vh-75">
                    <div class="col-12 col-md-8 col-lg-5">
                        <div class="card shadow">
                            <div class="card-body p-4 p-lg-5">
                                <div class="text-center mb-4">
                                    <div class="display-6 text-primary mb-2"><i class="fas fa-user-circle"></i></div>
                                    <h1 class="h3">Welcome back</h1>
                                    <p class="text-muted mb-0">Login to manage bookings, tools, and messages.</p>
                                </div>
                                <form>
                                    <div class="mb-3">
                                        <label class="form-label">Email</label>
                                        <input type="email" class="form-control" placeholder="you@@example.com" required>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Password</label>
                                        <input type="password" class="form-control" placeholder="Enter your password" required>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="rememberMe">
                                            <label class="form-check-label" for="rememberMe">Remember me</label>
                                        </div>
                                        <a href="/Home/support" class="text-decoration-none">Forgot password?</a>
                                    </div>
                                    <button type="button" class="btn btn-primary w-100"><i class="fas fa-sign-in-alt"></i> Login</button>
                                </form>
                                <div class="text-center mt-3">
                                    <span class="text-muted">Don't have an account?</span> <a href="/Home/register">Register here</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <footer class="footer py-4 mt-5">
            <div class="container text-center text-muted">
                <p class="mb-1">© 2024 ToolShare. All rights reserved.</p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a>
                    <a href="/Home/terms" class="text-decoration-none">Terms of Service</a>
                    <a href="/Home/support" class="text-decoration-none">Safety Guidelines</a>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
