<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/memberdashboard"><i class="fas fa-gauge-high"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/mytools"><i class="fas fa-toolbox"></i> My Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/mybookings"><i class="fas fa-calendar-check"></i> Bookings</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/wallet"><i class="fas fa-wallet"></i> Wallet</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Member/notifications"><i class="fas fa-bell"></i> Alerts</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/Home/profile"><i class="fas fa-user"></i> Profile</a></li>
                    <li class="nav-item"><button class="btn btn-outline-secondary"><i class="fas fa-sign-out-alt"></i> Logout</button></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            <div class="mb-4">
                <h1 class="h2 fw-bold mb-1">My Profile</h1>
                <p class="text-muted mb-0">Manage your account, contact details, verification, and preferences.</p>
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card shadow-sm mb-4">
                        <div class="card-body">
                            <div class="d-flex flex-column flex-md-row gap-3 align-items-md-center">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:84px;height:84px;font-size:2rem;">AH</div>
                                <div class="flex-grow-1">
                                    <h2 class="h4 mb-1">Ahmed Hassan</h2>
                                    <div class="text-muted mb-2"><i class="fas fa-envelope me-1"></i> ahmed.h@@mail.com • <i class="fas fa-phone ms-2 me-1"></i> +20 100 000 0000</div>
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge text-bg-primary">member</span>
                                        <span class="badge text-bg-success">verified</span>
                                        <span class="badge text-bg-warning text-dark">Pro eligible</span>
                                    </div>
                                </div>
                                <button class="btn btn-outline-primary"><i class="fas fa-edit"></i> Edit Profile</button>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Account Details</h2></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6"><label class="form-label">Full Name</label><input type="text" class="form-control" value="Ahmed Hassan"></div>
                                <div class="col-md-6"><label class="form-label">Email</label><input type="email" class="form-control" value="ahmed.h@@mail.com"></div>
                                <div class="col-md-6"><label class="form-label">Phone</label><input type="tel" class="form-control" value="+20 100 000 0000"></div>
                                <div class="col-md-6"><label class="form-label">Zone</label><select class="form-select"><option>Nasr City</option><option>Maadi</option><option>Heliopolis</option><option>Dokki</option><option>Zamalek</option></select></div>
                                <div class="col-12"><label class="form-label">Bio</label><textarea class="form-control" rows="3">I lend and borrow power tools for home projects.</textarea></div>
                            </div>
                            <button class="btn btn-primary mt-3"><i class="fas fa-save"></i> Save Changes</button>
                        </div>
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Security</h2></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6"><label class="form-label">Current Password</label><input type="password" class="form-control"></div>
                                <div class="col-md-6"><label class="form-label">New Password</label><input type="password" class="form-control"></div>
                                <div class="col-12"><button class="btn btn-outline-secondary"><i class="fas fa-key"></i> Update Password</button></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Reputation</h2></div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2"><span>Rating</span><strong><i class="fas fa-star text-warning"></i> 4.6</strong></div>
                            <div class="d-flex justify-content-between mb-2"><span>Reviews</span><strong>38</strong></div>
                            <div class="d-flex justify-content-between mb-2"><span>On-time returns</span><strong>94%</strong></div>
                            <div class="d-flex justify-content-between"><span>Disputes</span><strong>1</strong></div>
                            <a href="/Member/ratings" class="btn btn-sm btn-outline-primary w-100 mt-3">View Ratings & Reviews</a>
                        </div>
                    </div>
                    <div class="card shadow-sm">
                        <div class="card-header bg-white"><h2 class="h5 mb-0">Referral</h2></div>
                        <div class="card-body">
                            <p class="text-muted small">Share your code and earn credits when friends list tools.</p>
                            <div class="input-group mb-2"><input type="text" class="form-control" value="AHMED10" readonly><button class="btn btn-outline-primary">Copy</button></div>
                            <a href="/Member/referral" class="btn btn-outline-primary w-100">Refer & Earn</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5"><div class="container text-center text-muted"><p class="mb-1">© 2024 ToolShare. All rights reserved.</p><div class="d-flex justify-content-center gap-3"><a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a><a href="/Home/terms" class="text-decoration-none">Terms of Service</a><a href="/Home/support" class="text-decoration-none">Safety Guidelines</a></div></div></footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
