<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Support - ToolShare</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/howitworks">How It Works</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/Home/support">Support</a></li>
                    <li class="nav-item"><a class="btn btn-outline-primary" href="/Home/login">Login</a></li>
                    <li class="nav-item"><a class="btn btn-primary" href="/Home/register">Register</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h1 class="display-5 fw-bold">Support Center</h1>
                <p class="lead text-muted">Get help with bookings, payments, disputes, and account issues.</p>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-4"><a href="/Home/faq" class="card h-100 shadow-sm text-decoration-none text-dark"><div class="card-body text-center p-4"><i class="fas fa-question-circle fa-3x text-primary mb-3"></i><h3 class="h5">FAQ</h3><p class="text-muted small mb-0">Common questions about rentals, deposits, and safety.</p></div></a></div>
                <div class="col-md-4"><a href="/Home/contact" class="card h-100 shadow-sm text-decoration-none text-dark"><div class="card-body text-center p-4"><i class="fas fa-envelope fa-3x text-primary mb-3"></i><h3 class="h5">Contact Us</h3><p class="text-muted small mb-0">Reach the support team directly for urgent issues.</p></div></a></div>
                <div class="col-md-4"><a href="/Home/messages" class="card h-100 shadow-sm text-decoration-none text-dark"><div class="card-body text-center p-4"><i class="fas fa-comments fa-3x text-primary mb-3"></i><h3 class="h5">In-App Messages</h3><p class="text-muted small mb-0">Chat with librarians about a specific booking.</p></div></a></div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-white"><h2 class="h5 mb-0">Submit a Support Request</h2></div>
                <div class="card-body">
                    <form>
                        <div class="row g-3">
                            <div class="col-md-6"><label class="form-label">Subject</label><input type="text" class="form-control" placeholder="Brief description"></div>
                            <div class="col-md-6"><label class="form-label">Category</label><select class="form-select"><option>Booking issue</option><option>Payment / Deposit</option><option>Damage report</option><option>Account / KYC</option><option>Other</option></select></div>
                            <div class="col-12"><label class="form-label">Message</label><textarea class="form-control" rows="5" placeholder="Describe your issue in detail…"></textarea></div>
                            <div class="col-12"><button type="button" class="btn btn-primary"><i class="fas fa-paper-plane"></i> Send Request</button></div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5"><div class="container text-center text-muted"><p class="mb-1">© 2024 ToolShare. All rights reserved.</p><div class="d-flex justify-content-center gap-3"><a href="/Home/about" class="text-decoration-none">About</a><a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a><a href="/Home/terms" class="text-decoration-none">Terms of Service</a></div></div></footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
