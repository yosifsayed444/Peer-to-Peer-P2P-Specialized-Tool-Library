<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Browse Tools - P2P Tool Library</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link rel="stylesheet" href="/css/dashboard.css?v=2">
    <link rel="stylesheet" href="/css/components.css">
</head>
<body>
    <div id="app">
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item"><a class="nav-link nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                        <li class="nav-item"><a class="nav-link active" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                        <li class="nav-item"><a class="btn btn-outline-primary" href="/Home/login">Login</a></li>
                        <li class="nav-item"><a class="btn btn-primary" href="/Home/register">Register</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <main class="py-5">
            <div class="container">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
                    <div>
                        <h1 class="h2 fw-bold mb-1"><i class="fas fa-tools text-primary me-2"></i>Browse Tools</h1>
                        <p class="text-muted mb-0">Find the right tool near you, compare pricing, and book with confidence.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/Member/memberdashboard" class="btn btn-outline-primary"><i class="fas fa-gauge-high"></i> My Dashboard</a>
                        <a href="/Member/addtool" class="btn btn-primary"><i class="fas fa-plus"></i> Add Tool</a>
                    </div>
                </div>

                <div class="card shadow-sm mb-4" data-filter-for="toolsGrid">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-lg-5">
                                <label class="form-label">Search</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                                    <input type="text" class="form-control" placeholder="Example: cordless drill, saw, printer…">
                                </div>
                            </div>
                            <div class="col-lg-2 col-md-4">
                                <label class="form-label">Category</label>
                                <select class="form-select">
                                    <option value="">All Categories</option>
                                    <option>Power Tools</option>
                                    <option>Hand Tools</option>
                                    <option>Garden</option>
                                    <option>3D Printing</option>
                                    <option>Woodworking</option>
                                </select>
                            </div>
                            <div class="col-lg-2 col-md-4">
                                <label class="form-label">Zone</label>
                                <select class="form-select">
                                    <option value="">All Zones</option>
                                    <option>Nasr City</option>
                                    <option>Maadi</option>
                                    <option>Heliopolis</option>
                                    <option>Dokki</option>
                                    <option>Zamalek</option>
                                </select>
                            </div>
                            <div class="col-lg-3 col-md-4">
                                <label class="form-label">Sort By</label>
                                <select class="form-select" id="sortTools">
                                    <option>Top Rated</option>
                                    <option>Nearest First</option>
                                    <option>Price: Low to High</option>
                                    <option>Newest</option>
                                </select>
                            </div>
                        </div>
                        <div class="row g-3 mt-1">
                            <div class="col-md-2">
                                <label class="form-label">Min Price</label>
                                <input type="number" class="form-control" placeholder="0">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Max Price</label>
                                <input type="number" class="form-control" placeholder="500">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Radius (km)</label>
                                <input type="number" class="form-control" placeholder="5">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Available From</label>
                                <input type="date" class="form-control">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Available To</label>
                                <input type="date" class="form-control">
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <button class="btn btn-primary"><i class="fas fa-filter"></i> Apply Filters</button>
                            <button class="btn btn-outline-secondary"><i class="fas fa-rotate-left"></i> Reset</button>
                            <span class="badge text-bg-light border align-self-center" data-result-count>6 tools found</span>
                        </div>
                    </div>
                </div>

                <div class="row g-4" id="toolsGrid">
                    <div class="col-xl-3 col-lg-4 col-md-6" data-filter-item data-price="75" data-distance="1.2" data-rating="4.9" data-category="Power Tools" data-zone="Nasr City">
                        <div class="card h-100 tool-card shadow-sm">
                            <div class="bg-light text-center py-4 rounded-top">
                                <i class="fas fa-tools fa-3x text-primary"></i>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <h3 class="h5 mb-0">Cordless Drill</h3>
                                    <span class="badge text-bg-success">Available</span>
                                </div>
                                <div class="text-muted small mb-2"><i class="fas fa-map-marker-alt text-primary me-1"></i> Nasr City • 1.2 km</div>
                                <div class="mb-2"><span class="text-warning">★★★★★</span> <span class="text-muted small">(4.9 · 34 reviews)</span></div>
                                <div class="fw-bold text-primary fs-5">75 EGP/day</div>
                                <div class="text-muted small">Deposit: 500 EGP</div>
                            </div>
                            <div class="card-footer bg-white">
                                <a href="/Home/tooldetail" class="btn btn-primary w-100"><i class="fas fa-calendar-check"></i> View & Book</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-lg-4 col-md-6" data-filter-item data-price="15" data-distance="4.8" data-rating="4.4" data-category="Hand Tools" data-zone="Maadi">
                        <div class="card h-100 tool-card shadow-sm">
                            <div class="bg-light text-center py-4 rounded-top">
                                <i class="fas fa-hammer fa-3x text-primary"></i>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <h3 class="h5 mb-0">Claw Hammer</h3>
                                    <span class="badge text-bg-success">Available</span>
                                </div>
                                <div class="text-muted small mb-2"><i class="fas fa-map-marker-alt text-primary me-1"></i> Maadi • 4.8 km</div>
                                <div class="mb-2"><span class="text-warning">★★★★☆</span> <span class="text-muted small">(4.4 · 12 reviews)</span></div>
                                <div class="fw-bold text-primary fs-5">15 EGP/day</div>
                                <div class="text-muted small">Deposit: 100 EGP</div>
                            </div>
                            <div class="card-footer bg-white">
                                <a href="/Home/tooldetail" class="btn btn-primary w-100"><i class="fas fa-calendar-check"></i> View & Book</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-lg-4 col-md-6" data-filter-item data-price="20" data-distance="2.4" data-rating="4.8" data-category="Hand Tools" data-zone="Heliopolis">
                        <div class="card h-100 tool-card shadow-sm">
                            <div class="bg-light text-center py-4 rounded-top">
                                <i class="fas fa-screwdriver-wrench fa-3x text-primary"></i>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <h3 class="h5 mb-0">Screwdriver Set</h3>
                                    <span class="badge text-bg-success">Available</span>
                                </div>
                                <div class="text-muted small mb-2"><i class="fas fa-map-marker-alt text-primary me-1"></i> Heliopolis • 2.4 km</div>
                                <div class="mb-2"><span class="text-warning">★★★★★</span> <span class="text-muted small">(4.8 · 21 reviews)</span></div>
                                <div class="fw-bold text-primary fs-5">20 EGP/day</div>
                                <div class="text-muted small">Deposit: 120 EGP</div>
                            </div>
                            <div class="card-footer bg-white">
                                <a href="/Home/tooldetail" class="btn btn-primary w-100"><i class="fas fa-calendar-check"></i> View & Book</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-lg-4 col-md-6" data-filter-item data-price="60" data-distance="3.6" data-rating="4.2" data-category="Power Tools" data-zone="Dokki">
                        <div class="card h-100 tool-card shadow-sm">
                            <div class="bg-light text-center py-4 rounded-top">
                                <i class="fas fa-cog fa-3x text-primary"></i>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <h3 class="h5 mb-0">Angle Grinder</h3>
                                    <span class="badge text-bg-info">Rented</span>
                                </div>
                                <div class="text-muted small mb-2"><i class="fas fa-map-marker-alt text-primary me-1"></i> Dokki • 3.6 km</div>
                                <div class="mb-2"><span class="text-warning">★★★★☆</span> <span class="text-muted small">(4.2 · 18 reviews)</span></div>
                                <div class="fw-bold text-primary fs-5">60 EGP/day</div>
                                <div class="text-muted small">Deposit: 700 EGP</div>
                            </div>
                            <div class="card-footer bg-white">
                                <button class="btn btn-outline-primary w-100" disabled><i class="fas fa-clock"></i> Currently Rented</button>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-lg-4 col-md-6" data-filter-item data-price="25" data-distance="0.8" data-rating="4.7" data-category="Garden" data-zone="Nasr City">
                        <div class="card h-100 tool-card shadow-sm">
                            <div class="bg-light text-center py-4 rounded-top">
                                <i class="fas fa-tree fa-3x text-primary"></i>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <h3 class="h5 mb-0">Garden Shears</h3>
                                    <span class="badge text-bg-success">Available</span>
                                </div>
                                <div class="text-muted small mb-2"><i class="fas fa-map-marker-alt text-primary me-1"></i> Nasr City • 0.8 km</div>
                                <div class="mb-2"><span class="text-warning">★★★★★</span> <span class="text-muted small">(4.7 · 9 reviews)</span></div>
                                <div class="fw-bold text-primary fs-5">25 EGP/day</div>
                                <div class="text-muted small">Deposit: 150 EGP</div>
                            </div>
                            <div class="card-footer bg-white">
                                <a href="/Home/tooldetail" class="btn btn-primary w-100"><i class="fas fa-calendar-check"></i> View & Book</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-lg-4 col-md-6" data-filter-item data-price="150" data-distance="5.1" data-rating="4.9" data-category="3D Printing" data-zone="Zamalek">
                        <div class="card h-100 tool-card shadow-sm">
                            <div class="bg-light text-center py-4 rounded-top">
                                <i class="fas fa-print fa-3x text-primary"></i>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <h3 class="h5 mb-0">3D Printer</h3>
                                    <span class="badge text-bg-warning text-dark">High Value</span>
                                </div>
                                <div class="text-muted small mb-2"><i class="fas fa-map-marker-alt text-primary me-1"></i> Zamalek • 5.1 km</div>
                                <div class="mb-2"><span class="text-warning">★★★★★</span> <span class="text-muted small">(4.9 · 27 reviews)</span></div>
                                <div class="fw-bold text-primary fs-5">150 EGP/day</div>
                                <div class="text-muted small">Deposit: 3,000 EGP</div>
                            </div>
                            <div class="card-footer bg-white">
                                <a href="/Home/tooldetail" class="btn btn-primary w-100"><i class="fas fa-calendar-check"></i> View & Book</a>
                            </div>
                        </div>
                    </div>
                </div>

                <nav class="mt-4" aria-label="Results pagination">
                    <ul class="pagination justify-content-center">
                        <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
                        <li class="page-item active" aria-current="page"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">Next</a></li>
                    </ul>
                </nav>
            </div>
        </main>

        <footer class="footer py-4 mt-5">
            <div class="container text-center text-muted">
                <p class="mb-1">© 2024 ToolShare. All rights reserved.</p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a>
                    <a href="/Home/terms" class="text-decoration-none">Terms of Service</a>
                    <a href="/Home/support" class="text-decoration-none">Safety Guidelines</a>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
