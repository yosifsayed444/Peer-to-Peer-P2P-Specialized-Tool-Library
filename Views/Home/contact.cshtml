<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - ToolShare</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/bootstrap-overrides.css?v=1">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand logo" href="/Home/Index"><i class="fas fa-tools"></i><span>ToolShare</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" href="/Home/Index"><i class="fas fa-home"></i> Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/tools"><i class="fas fa-search"></i> Browse Tools</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/howitworks">How It Works</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/support">Support</a></li>
                    <li class="nav-item"><a class="btn btn-outline-primary" href="/Home/login">Login</a></li>
                    <li class="nav-item"><a class="btn btn-primary" href="/Home/register">Register</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h1 class="display-5 fw-bold">Contact Us</h1>
                <p class="lead text-muted">Reach our team for urgent issues or partnership inquiries.</p>
            </div>

            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="card shadow-sm h-100">
                        <div class="card-body p-4">
                            <h2 class="h5 mb-4">Get in Touch</h2>
                            <div class="d-flex gap-3 mb-3"><i class="fas fa-envelope text-primary mt-1"></i><div><strong>Email</strong><div class="text-muted small">support@@toolshare.example</div></div></div>
                            <div class="d-flex gap-3 mb-3"><i class="fas fa-phone text-primary mt-1"></i><div><strong>Phone</strong><div class="text-muted small">+20 100 000 0000</div></div></div>
                            <div class="d-flex gap-3 mb-3"><i class="fas fa-map-marker-alt text-primary mt-1"></i><div><strong>Address</strong><div class="text-muted small">Nasr City Library Desk, Cairo</div></div></div>
                            <div class="d-flex gap-3"><i class="fas fa-clock text-primary mt-1"></i><div><strong>Hours</strong><div class="text-muted small">Sat–Thu, 10 AM – 8 PM</div></div></div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="card shadow-sm h-100">
                        <div class="card-body p-4">
                            <h2 class="h5 mb-4">Send a Message</h2>
                            <form>
                                <div class="row g-3">
                                    <div class="col-md-6"><label class="form-label">Name</label><input type="text" class="form-control"></div>
                                    <div class="col-md-6"><label class="form-label">Email</label><input type="email" class="form-control"></div>
                                    <div class="col-12"><label class="form-label">Subject</label><input type="text" class="form-control"></div>
                                    <div class="col-12"><label class="form-label">Message</label><textarea class="form-control" rows="6"></textarea></div>
                                    <div class="col-12"><button type="button" class="btn btn-primary"><i class="fas fa-paper-plane"></i> Send</button></div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer py-4 mt-5"><div class="container text-center text-muted"><p class="mb-1">© 2024 ToolShare. All rights reserved.</p><div class="d-flex justify-content-center gap-3"><a href="/Home/about" class="text-decoration-none">About</a><a href="/Home/privacy" class="text-decoration-none">Privacy Policy</a><a href="/Home/terms" class="text-decoration-none">Terms of Service</a></div></div></footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui.js"></script>
</body>
</html>
